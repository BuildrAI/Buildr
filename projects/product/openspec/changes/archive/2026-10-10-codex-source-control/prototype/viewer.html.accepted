<!doctype html>
<!-- buildr:ui-prototype -->
<!-- buildr:ui-prototype-viewer -->
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Codex · 生成提交说明 · 原型阅读器</title><script id="buildr-prototype" type="application/json">{"version":1,"pages":[{"id":"commit-message","title":"生成说明与提交","notes":[{"id":"input","title":"常驻输入，生成辅助","text":"说明输入框默认一行，可直接手输；多行内容自动扩展。右侧统一机器人控件主点击生成，箭头选择仅本次使用的智能体；执行者显示在提示中。","position":"message-result"},{"id":"git","title":"提交独立执行","text":"主按钮直接执行 Git 提交，下拉切换提交或提交并推送。手写说明同样可提交，不依赖智能体可用。原型只模拟，不执行真实 Git。","position":"commit-actions"},{"id":"scope","title":"范围与推送边界","text":"使用当前来源全部未提交变更，含已暂存、未暂存与未跟踪。推送包含该分支此前所有未推送提交；未设置上游时只停推送，不猜测目标，已经完成的提交保留。","position":"commit-actions"},{"id":"agent","title":"默认与本次选择","text":"顶部显示当前默认智能体及状态；业务区域使用统一图标。仅本次选择在调用捕获执行者后复位，进行中和已有结果来源保持不变。每次生成使用临时会话，不积累对话历史。","position":"message-executor"}],"states":[{"id":"not-registered","title":"尚未接入智能体","notes":[{"id":"register","title":"由目标智能体接入","text":"生成暂不可用，仍可手写说明提交。通过全局入口复制接入请求，在目标智能体中发起。","position":"commit-message-panel"}]},{"id":"starting","title":"首次调用 · 正在准备","notes":[{"id":"startup","title":"首调用自动准备","text":"首次调用自动准备专用服务，再继续生成。取消保留已有草稿。","position":"message-actions"}]},{"id":"generating","title":"生成中","notes":[{"id":"busy","title":"仅显示短状态","text":"生成期间只显示执行者、状态和取消，不展开中间输出。全局默认变化不会改变本次执行者。","position":"message-actions"}]},{"id":"success","title":"说明已生成","notes":[{"id":"done","title":"可编辑与提交","text":"内容填回同一输入框，可编辑、复制、重新生成或提交。结果来源在提示中查看。","position":"message-result"}]},{"id":"running","title":"服务已运行 · 直接复用","notes":[{"id":"reuse","title":"后续调用复用","text":"服务已就绪，新的生成直接进入生成阶段。","position":"commit-message-panel"}]},{"id":"reclaimed","title":"空闲回收 · 保留结果","notes":[{"id":"reclaim","title":"回收服务保留成果","text":"模拟完全空闲 30 分钟后服务已回收，已有说明与接入记录保留；再次生成会自动启动。","position":"commit-message-panel"}]},{"id":"multiple-agents","title":"多个智能体示意","notes":[{"id":"future","title":"未来列表与本次选择示意","text":"仅此原型状态展示 Codex 与 DSH 的未来接入列表和选择，不代表 DSH 已实现。全局列表选中项是唯一默认；业务下拉可跟随默认或仅本次使用。服务状态按智能体分别保存，进行中及已有结果保留原执行者。","position":"message-executor"}]},{"id":"login-required","title":"需要完成 Codex 授权","notes":[{"id":"login","title":"沿用原有授权","text":"从全局智能体的详情查看引导，完成 Codex 原有授权后重试；接入记录保留。","position":"commit-message-panel"}]},{"id":"unavailable","title":"Codex 暂不可用","notes":[{"id":"unavailable-note","title":"只阻止新的生成","text":"仅阻止新的生成，手写说明仍可提交；已有说明与接入记录保留。","position":"commit-message-panel"}]},{"id":"error","title":"生成失败 · 保留说明","notes":[{"id":"failed","title":"局部失败可重试","text":"失败提示限于生成区域，保留原说明及修改，不要求重新注册。","position":"commit-message-panel"}]},{"id":"no-changes","title":"没有未提交变更","notes":[{"id":"empty","title":"无变更不调用","text":"没有未提交文件时生成与提交不可用，不启动智能体服务。","position":"commit-message-panel"}]},{"id":"content-changed","title":"变更更新 · 需重新生成","notes":[{"id":"changed","title":"保留已有说明","text":"当前内容与上次生成时不一致，显示局部提示并保留原说明。","position":"commit-message-panel"}]},{"id":"committing","title":"正在提交","notes":[{"id":"committing-note","title":"固定来源与说明","text":"提交使用点击时的来源与说明，输入暂不可改；智能体不执行提交。","position":"commit-actions"}]},{"id":"pushing","title":"已提交 · 正在推送","notes":[{"id":"pushing-note","title":"先提交，再推送","text":"提交已完成，变更列表已清空；推送包括该分支此前全部未推送提交。","position":"commit-actions"}]},{"id":"commit-success","title":"提交成功","notes":[{"id":"commit-success-note","title":"当前来源已提交","text":"模拟提交后只清空当前来源变更，其他工作树保持独立。","position":"commit-actions"}]},{"id":"commit-push-success","title":"提交并推送成功","notes":[{"id":"commit-push-success-note","title":"两步分别完成","text":"提交和推送已完成，当前来源没有未提交文件。","position":"commit-actions"}]},{"id":"push-will-fail","title":"提交并推送 · 失败演示","notes":[{"id":"push-will-fail-note","title":"点击演示部分成功","text":"点击提交并推送，先模拟提交成功，再推送失败。重试只推送原来源已有提交。","position":"commit-actions"}]},{"id":"push-failed","title":"已提交 · 推送失败","notes":[{"id":"push-failed-note","title":"重试只推送","text":"保留提交身份和原来源，不重复提交、不恢复变更。重试仅推送该分支尚未推送提交。","position":"commit-actions"}]},{"id":"upstream-missing","title":"未设置上游 · 只停推送","notes":[{"id":"upstream-missing-note","title":"不猜测推送目标","text":"点击提交并推送，提交完成后停在推送前，保留已提交成果；普通提交可独立完成。","position":"commit-actions"}]}]},{"id":"agents","title":"全局智能体接入","notes":[{"id":"list","title":"紧凑列表与唯一默认","text":"列表只显示名称、运行状态与默认标记。点击一行将它设为之后新调用的默认，不改变已进行的工作或已有结果。","position":"global-agents"},{"id":"details","title":"详情按需查看","text":"点击每行详情查看必要接入状态、自动准备和复用、完全空闲 30 分钟回收、临时生成不留历史，以及退出清理规则；默认不铺开说明。","position":"global-agents"},{"id":"add","title":"统一接入入口","text":"点击“接入”，复制通用一句话，在希望接入的智能体中发起。无需选择本机安装，不填写路径、端口或密钥。原型不执行注册，也不把复制当作已接入。","position":"global-agents"}],"states":[{"id":"not-registered","title":"未接入 · 复制通用请求","notes":[{"id":"request","title":"交给目标智能体","text":"把请求发给希望使用的智能体。外部注册完成用阅读器切换已接入状态模拟。","position":"agent-registration"}]},{"id":"multiple-agents","title":"多个智能体示意","notes":[{"id":"future","title":"未来扩展示意","text":"展示 Codex 与 DSH 未来列表及默认选择，不代表 DSH 已实现。Codex 与 DSH 的服务状态分别保留。业务本次选择不会改动全局默认。","position":"agent-list"}]},{"id":"starting","title":"服务准备中","notes":[{"id":"starting-note","title":"自动继续","text":"首次工作正在准备，无需手动启动服务。","position":"agent-list"}]},{"id":"running","title":"服务运行中","notes":[{"id":"running-note","title":"继续复用","text":"后续调用复用已运行的专用服务。","position":"agent-list"}]},{"id":"reclaimed","title":"空闲服务已回收","notes":[{"id":"reclaimed-note","title":"成果仍保留","text":"服务完全空闲后已释放，接入记录与已有生成结果保留；下次调用自动准备。","position":"agent-list"}]},{"id":"login-required","title":"需要完成原有授权","notes":[{"id":"authorize","title":"查看详情处理授权","text":"点击 Codex 详情查看授权引导，前往 Codex 完成原有授权。原型检查不会伪造成功。","position":"agent-list"}]},{"id":"unavailable","title":"暂不可用 · 接入保留","notes":[{"id":"unavailable-note","title":"查看详情处理状态","text":"点击详情查看当前问题，恢复后可继续，不要求重新接入。","position":"agent-list"}]}]},{"id":"exit","title":"退出与专用服务清理","notes":[{"id":"shutdown","title":"退出时联动清理","text":"模拟退出时停止进行中的生成，并关闭 Buildr 启动的专用服务，接入记录保留。关闭浏览器标签不等于退出 Buildr。本原型不会调用真实退出操作。","position":"exit-result"}],"states":[{"id":"busy","title":"生成中退出 · 停止并清理","notes":[{"id":"busy-exit","title":"停止并关闭","text":"停止进行中的生成，关闭专用服务后显示退出结果。","position":"exit-result"}]},{"id":"exited","title":"Buildr 已退出","notes":[{"id":"done-exit","title":"清理完成","text":"专用服务已关闭，接入记录保留；可通过阅读器恢复其他页面。","position":"exit-result"}]}]}]}</script><script id="buildr-prototype-source" type="application/json">{"observedAt":"2026-10-09T12:45:34.334Z","commit":"01e4db43a83ab6a312ea3aff7363a3fd52eb4b77","uncommittedSummary":"临时讨论原型第四版：常驻说明输入、统一AgentActionControl、独立模拟提交与推送及部分失败重试；archive/v3保全上一版。紧凑提交说明，结果按需展开/收起，全局智能体列表、唯一默认与本次选择，执行者/成果身份和服务状态分别保留；archive/v2保全上一版。全局Codex接入、首调用启动/后续复用/完全空闲30分钟回收、临时生成会话与模拟退出清理；archive/v1保全旧版。正式仓库零改动。正式 AppShellHeader/AppShellFrame/ObjectTabStrip、MockSourceControlWorkbench、主题、PrototypeReaderLayout/PrototypeTab 与 ui-prototype 功能说明保持直接导入；SourceControlWorkbench 仅在临时目录保留局部快照，新增未提交区生成面板插槽，构建时定向替换。其余模拟数据、状态和样式位于临时目录；不接真实后端、模型或 Git 写入。","snapshotSource":"src/features/code/components/SourceControlWorkbench.tsx","sources":[{"path":"src/components/SideReadingPanel.tsx","sha256":"29500e5c557008909347b97469125be5bf40db250e46c8c35f340b91b6428d0a"},{"path":"src/components/side-reading.css","sha256":"3ae62b9029b0619529e34a130500ba3864dc5640f0b816144ab757b0190ce94e"},{"path":"src/components/useSideReading.ts","sha256":"3ca0b521b7b78a4866d5b4beaf4739f2439c2f4fac744a8fb5821e339573b33b"},{"path":"src/features/task/components/PrototypeFeatureNotes.tsx","sha256":"a00f2a9a2ccaa47adb39b04ca059c47316484f75c7cb2940253b81caa70e2926"},{"path":"src/features/task/components/PrototypeReaderLayout.tsx","sha256":"77f6c68fd370560edb7cabdeaecdbd9189b16a839a310904eeb11a73f39938ef"},{"path":"src/features/task/components/PrototypeTab.tsx","sha256":"c2429e76114cb80e679e2052c8b560900e9bcbe229dbac1da984e00034b3f568"},{"path":"src/features/task/components/prototype-content.ts","sha256":"2699468da507361f4b9c4d5a689cebc191be2e61d25743fdb6c27c1ebc265329"},{"path":"src/features/task/components/prototype-reader.css","sha256":"c09a1cd283677132b4b356ea3c5423064dd5cb35c5fa8726151d228ecb6e7512"},{"path":"src/styles.css","sha256":"fd79e6fe5f921a4075d19127fa75d03c7b524724454574731ef63dc26f6d746f"},{"path":"src/theme.ts","sha256":"db726d944603ef8bdb2eb3c66cc04e4bb647f7a2108d381a73e00f4533210fa0"},{"path":"../buildr/resources/workspace/skills/buildr/ui-prototype/assets/feature-notes.css","sha256":"0772c8c4e6305be4deb0c0922577b1eb337d1702652910ad9d665b0ed38c37fe"},{"path":"../buildr/resources/workspace/skills/buildr/ui-prototype/assets/feature-notes.js","sha256":"6ef65fac29f30a6f5aad92c93598770e7e3addc2038d633698bf594833140e44"}]}</script><style>.prototype-features-hint{color:var(--soft-muted,#667085);font-size:12px;line-height:1.7;margin:0 0 14px}.prototype-feature{display:block;width:100%;margin:0 0 12px;padding:14px;border:1px solid var(--soft-line,#dce2e8);border-radius:8px;background:var(--soft-surface,#fff);color:var(--soft-ink,#252b33);text-align:left;font:inherit}button.prototype-feature{cursor:pointer;transition:background .12s,border-color .12s}.prototype-feature strong,.prototype-feature h3{display:block;font-size:14px;line-height:1.5;margin:0 0 8px;font-weight:600}.prototype-feature>span,.prototype-feature p{display:block;margin:0;font-size:13px;line-height:1.8;white-space:pre-wrap}.prototype-feature.is-active,button.prototype-feature:hover,button.prototype-feature:focus-visible{border-color:var(--soft-primary,#397d74);background:#f1f7f4}button.prototype-feature:focus-visible{outline:2px solid var(--soft-primary,#397d74);outline-offset:2px}[data-prototype-highlight=true]{outline:2px solid var(--soft-primary,#397d74);outline-offset:3px;box-shadow:0 0 0 5px #397d741a;border-radius:6px}.side-reading{position:absolute;z-index:4;inset:0 0 0 auto;width:min(520px,100%);min-width:0;display:flex;flex-direction:column;overflow:hidden;background:var(--soft-surface,#fff);border:1px solid var(--soft-line);border-radius:10px 0 0 10px;box-shadow:-10px 0 28px #14231e1f;animation:side-reading-enter .18s ease-out}.side-reading[hidden]{display:none}.side-reading-heading{display:flex;align-items:center;justify-content:space-between;flex:none;padding:14px 16px;border-bottom:1px solid var(--soft-line)}.side-reading-heading h2{font-size:14px;font-weight:600;margin:0}.side-reading-body{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;padding:16px 20px}.side-reading-body>section>h3{font-size:12px;font-weight:500;color:var(--soft-muted)}@keyframes side-reading-enter{0%{transform:translate(100%);opacity:0}to{transform:translate(0);opacity:1}}@media(prefers-reduced-motion:reduce){.side-reading{animation:none}}.side-reading.is-pinned{position:relative;inset:auto;width:340px;flex:none;border-radius:10px;box-shadow:none;animation:none}.prototype-reader{min-width:0;position:relative}.prototype-reader[hidden]{display:none}.prototype-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;flex-wrap:wrap}.prototype-toolbar h2{font-size:16px;margin:0}.prototype-toolbar>div{display:flex;gap:8px}.prototype-source{border:0;background:transparent;padding:0;color:var(--soft-muted);font-size:12px;margin-bottom:12px;overflow-wrap:anywhere}.prototype-reading-layout{position:relative;display:flex;gap:16px;min-height:480px;margin-top:12px}.prototype-canvas{min-width:0;flex:1}.prototype-viewport{height:max(740px,calc(100vh - 150px));overflow:hidden;border:1px solid var(--soft-line);border-radius:8px}.prototype-canvas iframe{width:100%;height:100%;border:1px solid var(--soft-line);border-radius:8px;background:#fff;display:block}.prototype-standalone{padding:16px;min-height:100vh;background:var(--soft-surface);display:grid;grid-template-columns:156px minmax(0,1fr);gap:16px}.prototype-standalone nav{border-right:1px solid var(--soft-line);padding-right:16px}.prototype-standalone nav button{display:block;width:100%;height:auto;white-space:normal;text-align:left;margin:5px 0;padding:10px}.prototype-standalone nav small{display:block;color:var(--soft-muted);font-size:10px}@media(max-width:700px){.prototype-standalone{grid-template-columns:minmax(0,1fr);gap:16px;padding:12px}.prototype-standalone>nav{display:flex;align-items:center;flex-wrap:wrap;gap:6px;border-right:0;border-bottom:1px solid var(-