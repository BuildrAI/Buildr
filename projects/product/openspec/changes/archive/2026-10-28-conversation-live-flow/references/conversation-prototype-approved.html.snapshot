d4e170e82afc8ceba2974d23b0c54f4741017cd"},{"path":"src/markdown.ts","sha256":"81a95a1449ed0aa0ec0e8f0b1608e653caa4e9094dc54c3fff5667a4c3ffefed"},{"path":"src/prototypes/conversation-live-flow/fixtures.ts","sha256":"365379a8c11ed834b906a2dc3265d7835a3d806a39bf3d13a56238b77532115a"},{"path":"src/prototypes/conversation-live-flow/main.tsx","sha256":"512925c10619cf136f1426292727cc8e0790227602a4d61c5edc57ecfe032c17"},{"path":"src/prototypes/conversation-live-flow/mock-client.ts","sha256":"11bae81841bce3687125d502079eac2c38bfff12bd1b501e689d3d07b0078be1"},{"path":"src/prototypes/conversation-live-flow/preview.css","sha256":"743930a0f3a9fb91309348b35c9296ecdaa07d8016bba0569fe40b378c5d2714"},{"path":"src/prototypes/conversation-live-flow/scenes.json","sha256":"6552c48cb67d8b6e0f949c8632be05ae831c017529561b887fccf2e6c8b5bad4"},{"path":"src/prototypes/prototype-bridge.ts","sha256":"28512317ca211fa779b57cf6dea90507256e0ff0e736c0e56d4b4e312f8313df"},{"path":"src/styles.css","sha256":"e34074f661c3b71b4398b1c82647f0fe16b60043f02b3aebd3d2542e2fd85945"},{"path":"src/theme.ts","sha256":"74170100738a8423c04efe35d6fc5e859bd234feba709fabd9448d94b03bd341"},{"path":"../buildr/resources/workspace/skills/buildr/ui-prototype/assets/feature-notes.css","sha256":"0772c8c4e6305be4deb0c0922577b1eb337d1702652910ad9d665b0ed38c37fe"},{"path":"../buildr/resources/workspace/skills/buildr/ui-prototype/assets/feature-notes.js","sha256":"6ef65fac29f30a6f5aad92c93598770e7e3addc2038d633698bf594833140e44"}]}</script><style>.split-divider{position:relative;flex:none;width:9px;align-self:stretch;padding:0;border:0;background:transparent;cursor:col-resize;touch-action:none;z-index:4}.split-divider:before{content:"";position:absolute;inset:0 auto 0 4px;width:1px;background:var(--soft-line);transition:background .15s ease}.split-divider:after{content:"";position:absolute;top:50%;left:50%;width:3px;height:32px;transform:translate(-50%,-50%);border-radius:4px;background:#b8cbc3;transition:background .15s ease}.split-divider:hover:before,.split-divider:focus-visible:before,.split-divider:active:before{background:var(--soft-primary)}.split-divider:hover:after,.split-divider:focus-visible:after,.split-divider:active:after{background:var(--soft-primary)}.split-divider:focus-visible{outline:2px solid var(--soft-primary);outline-offset:-2px}.split-divider.is-horizontal{width:auto;height:9px;cursor:row-resize}.split-divider.is-horizontal:before{inset:4px 0 auto;width:auto;height:1px}.split-divider.is-horizontal:after{width:32px;height:3px}@media(prefers-reduced-motion:reduce){.split-divider:before,.split-divider:after{transition:none}}.split-divider-header-marker{position:absolute;top:-31px;left:4px;width:1px;height:19px;background:var(--soft-line);pointer-events:none}.pane-toggle-button.ant-btn{display:inline-flex;flex:none;align-items:center;justify-content:center;width:28px;min-width:28px;height:28px;padding:0;border-radius:6px;font-size:14px;color:var(--soft-muted)}.pane-toggle-button.ant-btn:not(:disabled):hover{color:var(--soft-ink)!important;background:#ffffffbf!important}.unified-pane-controls .app-sidebar-head{justify-content:flex-end;padding-inline:10px}.unified-pane-controls.sidebar-collapsed .app-sidebar-head{justify-content:center;padding-inline:0}.primary-navigation{--primary-rail-width:52px;display:flex;flex:none;position:relative;z-index:8;min-height:0;background:#fff;border-right:1px solid var(--soft-line,#e1e5e9)}.primary-navigation.is-pinned{border-right:0}.primary-navigation-rail{width:var(--primary-rail-width);flex:none;display:flex;flex-direction:column;gap:12px;padding:6px 5px 10px;align-items:center;border-right:1px solid var(--soft-line,#e1e5e9)}.primary-navigation-rail>div{width:100%}.primary-navigation-rail .shell-nav-item{position:relative;box-sizing:border-box;width:40px;height:40px;padding:0;margin:0;display:flex;align-items:center;justify-content:center;border:0;border-radius:8px;background:transparent;color:var(--soft-muted,#7e8a84);font:inherit;cur