#!/bin/sh
set -u

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self="${self%/*}/$link" ;;
  esac
done
script_root=$(CDPATH= cd "${self%/*}" && pwd)
product_root=$(CDPATH= cd "$script_root/../../../.." && pwd)
IFS= read -r required_version < "$product_root/.node-version"
next_major=$(( ${required_version%%.*} + 1 ))

node_version() {
  "$1" -p 'process.versions.node' 2>/dev/null
}

is_declared_node() {
  [ -x "$1" ] || return 1
  [ "$(node_version "$1")" = "$required_version" ]
}

# Accept the declared version and any newer Node on the same major line;
# the major match is the upper bound (< next major).
is_acceptable_node() {
  [ -x "$1" ] || return 1
  candidate_version=$(node_version "$1") || return 1
  case "$candidate_version" in
    *[!0-9.]*) return 1 ;;
    *.*.*) ;;
    *) return 1 ;;
  esac
  [ "${candidate_version%%.*}" = "${required_version%%.*}" ] || return 1
  req_minor=${required_version#*.}; req_minor=${req_minor%%.*}
  got_minor=${candidate_version#*.}; got_minor=${got_minor%%.*}
  [ "$got_minor" -gt "$req_minor" ] && return 0
  [ "$got_minor" -eq "$req_minor" ] || return 1
  req_patch=${required_version#*.*.}
  got_patch=${candidate_version#*.*.}
  [ "$got_patch" -ge "$req_patch" ]
}

select_declared_node() {
  candidate=$1
  case "$candidate" in
    */*) ;;
    *) candidate=$(command -v "$candidate" 2>/dev/null || true) ;;
  esac
  if is_declared_node "$candidate"; then
    printf '%s\n' "$candidate"
    exit 0
  fi
}

select_node() {
  candidate=$1
  case "$candidate" in
    */*) ;;
    *) candidate=$(command -v "$candidate" 2>/dev/null || true) ;;
  esac
  if is_acceptable_node "$candidate"; then
    printf '%s\n' "$candidate"
    exit 0
  fi
}

if [ "${BUILDR_NODE+x}" = x ]; then
  select_node "$BUILDR_NODE"
  echo "Buildr Product checkout requires Node.js >=${required_version} <${next_major}; BUILDR_NODE resolved to an out-of-range or invalid executable." >&2
  exit 1
fi

if [ "${NVM_DIR+x}" = x ] && [ -n "$NVM_DIR" ]; then
  select_declared_node "$NVM_DIR/versions/node/v$required_version/bin/node"
fi

old_ifs=$IFS
IFS=:
for path_entry in ${PATH:-}; do
  [ -n "$path_entry" ] || path_entry=.
  select_node "$path_entry/node"
done
for path_entry in ${PATH:-}; do
  [ -n "$path_entry" ] || path_entry=.
  select_node "$path_entry/../../node/bin/node"
done
IFS=$old_ifs

echo "Buildr Product checkout requires Node.js >=${required_version} <${next_major}. Set BUILDR_NODE to a compatible executable or activate the Product .node-version (Node ${required_version}) before running checkout commands." >&2
exit 1
