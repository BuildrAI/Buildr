#!/usr/bin/env bash
set -euo pipefail

service_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
node_executable="${BUILDR_NODE_EXECUTABLE:-$(command -v node || true)}"

if [[ -z "$node_executable" || ! -x "$node_executable" ]]; then
  echo "Buildr development installation requires a compatible Host Node." >&2
  exit 1
fi

exec "$node_executable" "$service_root/package/launchers/manage.mjs" install --channel development "$@"
