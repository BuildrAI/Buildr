#!/usr/bin/env bash
set -euo pipefail

product_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_bin="$product_root/scripts/run-development-cli"
legacy_project_bin="$(cd "$product_root/../.." && pwd)/bin/buildr.mjs"
legacy_service_bin="$product_root/bin/buildr.mjs"
install_dir="${BUILDR_CLI_INSTALL_DIR:-$HOME/.local/bin}"
target_bin="$install_dir/buildr"
node_executable="${BUILDR_NODE_EXECUTABLE:-}"
wrapper_marker='# buildr-development-cli-wrapper/v1'

while [[ $# -gt 0 ]]; do
  case "$1" in
    --node-executable)
      [[ $# -ge 2 ]] || { echo "Missing value for --node-executable." >&2; exit 2; }
      node_executable="$2"
      shift 2
      ;;
    --install-dir)
      [[ $# -ge 2 ]] || { echo "Missing value for --install-dir." >&2; exit 2; }
      install_dir="$2"
      target_bin="$install_dir/buildr"
      shift 2
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 2
      ;;
  esac
done

if [[ -z "$node_executable" ]]; then
  node_executable="$(command -v node || true)"
fi

if [[ -z "$node_executable" || ! -x "$node_executable" ]]; then
  echo "Buildr requires Node.js >=24.15.0 <25." >&2
  exit 1
fi

node_executable="$(cd "$(dirname "$node_executable")" && pwd)/$(basename "$node_executable")"
node_compatible="$("$node_executable" -p 'const [major, minor] = process.versions.node.split(".").map(Number); Number(major === 24 && minor >= 15)')"
if [[ "$node_compatible" != 1 ]]; then
  echo "Buildr requires Node.js >=24.15.0 <25; current version: $("$node_executable" --version)" >&2
  exit 1
fi

if ! (cd "$product_root" && "$node_executable" --input-type=module -e "import('yaml')" >/dev/null 2>&1); then
  if ! command -v npm >/dev/null 2>&1; then
    echo "Buildr runtime dependencies are missing and npm is unavailable." >&2
    exit 1
  fi
  echo "Preparing Buildr runtime dependencies from package-lock.json..."
  (cd "$product_root" && npm ci --omit=dev)
fi

if [[ ! -x "$source_bin" ]]; then
  echo "Buildr CLI source is not executable: $source_bin" >&2
  exit 1
fi

is_managed_wrapper() {
  [[ -f "$1" && ! -L "$1" ]] || return 1
  [[ "$(sed -n '1p' "$1")" == '#!/bin/sh' ]] || return 1
  [[ "$(sed -n '2p' "$1")" == "$wrapper_marker" ]] || return 1
  [[ "$(sed -n '3p' "$1")" == 'set -eu' ]] || return 1
  [[ "$(sed -n '4p' "$1")" == BUILDR_NODE=\'*\' ]] || return 1
  [[ "$(sed -n '5p' "$1")" == "BUILDR_DEVELOPMENT_CLI_WRAPPER='buildr.development-cli-wrapper/v1'" ]] || return 1
  [[ "$(sed -n '6p' "$1")" == 'export BUILDR_NODE BUILDR_DEVELOPMENT_CLI_WRAPPER' ]] || return 1
  [[ "$(sed -n '7p' "$1")" == exec\ \'*\'\ \"\$@\" ]] || return 1
  [[ "$(wc -l < "$1" | tr -d '[:space:]')" == 7 ]]
}

shell_quote() {
  local value="${1//\'/\'\\\'\'}"
  printf "'%s'" "$value"
}

mkdir -p "$install_dir"

if [[ -e "$target_bin" || -L "$target_bin" ]]; then
  managed_buildr=false
  if is_managed_wrapper "$target_bin"; then
    managed_buildr=true
  elif [[ -L "$target_bin" ]]; then
    existing_target="$(readlink "$target_bin" 2>/dev/null || true)"
    if [[ "$existing_target" == "$source_bin" ]]; then
      managed_buildr=true
    elif [[ -n "$existing_target" ]]; then
      resolved_existing_target="$existing_target"
      if [[ "$resolved_existing_target" != /* ]]; then
        resolved_existing_target="$install_dir/$resolved_existing_target"
      fi
      if [[ "$resolved_existing_target" == "$legacy_project_bin" || "$resolved_existing_target" == "$legacy_service_bin" ]]; then
        managed_buildr=true
      fi
    fi
  fi
  if [[ "$managed_buildr" != true ]]; then
    echo "Refusing to overwrite existing buildr command: $target_bin" >&2
    echo "Remove it first, or set BUILDR_CLI_INSTALL_DIR to another directory." >&2
    exit 1
  fi
fi

temporary_wrapper="$(mktemp "$install_dir/.buildr-development-cli.XXXXXX")"
cleanup_temporary_wrapper() {
  rm -f "$temporary_wrapper"
}
trap cleanup_temporary_wrapper EXIT
{
  printf '%s\n' '#!/bin/sh'
  printf '%s\n' "$wrapper_marker"
  printf '%s\n' 'set -eu'
  printf 'BUILDR_NODE=%s\n' "$(shell_quote "$node_executable")"
  printf '%s\n' "BUILDR_DEVELOPMENT_CLI_WRAPPER='buildr.development-cli-wrapper/v1'"
  printf '%s\n' 'export BUILDR_NODE BUILDR_DEVELOPMENT_CLI_WRAPPER'
  printf 'exec %s "$@"\n' "$(shell_quote "$source_bin")"
} > "$temporary_wrapper"
chmod 0755 "$temporary_wrapper"

identity_json="$(BUILDR_INTERNAL_DEVELOPMENT_CLI_IDENTITY_JSON=1 "$temporary_wrapper")"
BUILDR_INSTALLED_IDENTITY="$identity_json" BUILDR_EXPECTED_LAUNCHER="$source_bin" BUILDR_EXPECTED_CLI_ENTRY="$product_root/bin/buildr.mjs" BUILDR_EXPECTED_NODE="$node_executable" "$node_executable" --input-type=module -e '
  import fs from "node:fs";
  const identity = JSON.parse(process.env.BUILDR_INSTALLED_IDENTITY);
  const same = (left, right) => fs.realpathSync(left) === fs.realpathSync(right);
  if (identity.schemaVersion !== "buildr.development-cli-identity/v1"
    || identity.wrapperSchema !== "buildr.development-cli-wrapper/v1"
    || !same(identity.launcher, process.env.BUILDR_EXPECTED_LAUNCHER)
    || !same(identity.cliEntry, process.env.BUILDR_EXPECTED_CLI_ENTRY)
    || !same(identity.nodeExecutable, process.env.BUILDR_EXPECTED_NODE)) process.exit(1);
'
mv -f "$temporary_wrapper" "$target_bin"
trap - EXIT

echo "Installed buildr wrapper -> $source_bin (Node: $node_executable)"

case ":$PATH:" in
  *":$install_dir:"*)
    echo "buildr is available on PATH."
    ;;
  *)
    echo "$install_dir is not on PATH. Add it to your shell config, for example:"
    echo "  export PATH=\"$install_dir:\$PATH\""
    ;;
esac
