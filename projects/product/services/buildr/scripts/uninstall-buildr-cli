#!/usr/bin/env bash
set -euo pipefail

product_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_bin="$product_root/scripts/run-development-cli"
legacy_project_bin="$(cd "$product_root/../.." && pwd)/bin/buildr.mjs"
legacy_service_bin="$product_root/bin/buildr.mjs"
install_dir="${BUILDR_CLI_INSTALL_DIR:-$HOME/.local/bin}"
target_bin="$install_dir/buildr"
wrapper_marker='# buildr-development-cli-wrapper/v1'

is_managed_wrapper() {
  [[ -f "$1" && ! -L "$1" ]] || return 1
  [[ "$(sed -n '1p' "$1")" == '#!/bin/sh' ]] || return 1
  [[ "$(sed -n '2p' "$1")" == "$wrapper_marker" ]] || return 1
  [[ "$(sed -n '3p' "$1")" == 'set -eu' ]] || return 1
  [[ "$(sed -n '4p' "$1")" == BUILDR_NODE=\'*\' ]] || return 1
  [[ "$(sed -n '5p' "$1")" == "BUILDR_DEVELOPMENT_CLI_WRAPPER='buildr.development-cli-wrapper/v1'" ]] || return 1
  [[ "$(sed -n '6p' "$1")" == 'export BUILDR_NODE BUILDR_DEVELOPMENT_CLI_WRAPPER' ]] || return 1
  [[ "$(sed -n '7p' "$1")" == exec\ \'*\'\ \"\$@\" ]] || return 1
  [[ "$(wc -l < "$1" | tr -d '[:space:]')" == 7 ]]
}

if [[ ! -e "$target_bin" && ! -L "$target_bin" ]]; then
  echo "No Buildr-managed command found at $target_bin"
  exit 0
fi

managed_buildr=false
if is_managed_wrapper "$target_bin"; then
  managed_buildr=true
elif [[ -L "$target_bin" ]]; then
  existing_target="$(readlink "$target_bin")"
  if [[ "$existing_target" != /* ]]; then
    existing_target="$install_dir/$existing_target"
  fi
  if [[ "$existing_target" == "$source_bin" || "$existing_target" == "$legacy_project_bin" || "$existing_target" == "$legacy_service_bin" ]]; then
    managed_buildr=true
  fi
fi

if [[ "$managed_buildr" != true ]]; then
  echo "Refusing to remove buildr command not managed by this checkout: $target_bin" >&2
  exit 1
fi

rm "$target_bin"
echo "Uninstalled buildr from $target_bin"
