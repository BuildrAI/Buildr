{
  "name": "@buildr-ai/buildr",
  "version": "0.1.0-rc.29",
  "private": false,
  "description": "Buildr CLI for managing Agent workspace assets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildrAI/Buildr.git",
    "directory": "projects/product/services/buildr"
  },
  "homepage": "https://github.com/BuildrAI/Buildr#readme",
  "bugs": {
    "url": "https://github.com/BuildrAI/Buildr/issues"
  },
  "keywords": [
    "agent",
    "agentic-coding",
    "cli",
    "developer-tools",
    "workspace"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    "./test-context": {
      "types": "./package/targets/test-context/index.d.ts",
      "import": "./test-context.mjs",
      "default": "./test-context.mjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "bin": {
    "buildr": "bin/buildr.mjs"
  },
  "files": [
    "LICENSE",
    "bin/buildr.mjs",
    "test-context.mjs",
    "package/targets/test-context/",
    "src/",
    "README.md",
    "docs/agent-runtime-adapters.md",
    "docs/cli-reference.md",
    "docs/skill-capability-contracts.md",
    "docs/cli-architecture.md",
    "docs/known-limitations.md",
    "docs/bootstrap-guide.md",
    "docs/resources.md",
    "resources/",
    "web-dist/",
    "package/targets/runtime/"
  ],
  "scripts": {
    "test": "npm run artifacts:prepare && ./test/verification/verify-buildr-product-fast",
    "test:fast": "npm run artifacts:prepare && ./test/verification/verify-buildr-product-fast",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:component": "node --test test/component/*.test.ts",
    "test:contract": "node --test test/contract/*.test.ts",
    "test:integration": "node --test test/integration/*.test.ts",
    "contracts:generate": "node tools/contracts/task-record-dto.ts && node tools/contracts/task-professional-dto.ts && node tools/contracts/runtime-system-dto.ts",
    "contracts:check": "node tools/contracts/task-record-dto.ts --check && node tools/contracts/task-professional-dto.ts --check && node tools/contracts/runtime-system-dto.ts --check",
    "contracts:generate:workspace": "node tools/contracts/workspace-agent-assets-dto.ts",
    "contracts:check:workspace": "node tools/contracts/workspace-agent-assets-dto.ts --check",
    "contracts:prepare": "npm run contracts:generate && npm run contracts:generate:workspace",
    "contracts:professional:generate": "node tools/contracts/task-professional-dto.ts",
    "contracts:professional:check": "node tools/contracts/task-professional-dto.ts --check",
    "contracts:generate:runtime-system": "node tools/contracts/runtime-system-dto.ts",
    "contracts:check:runtime-system": "node tools/contracts/runtime-system-dto.ts --check",
    "test-context:generate": "node tools/testing/test-context-build.ts generate",
    "test-context:check": "node tools/testing/test-context-build.ts check",
    "artifacts:prepare": "npm run contracts:prepare && npm run test-context:generate",
    "typecheck": "npm run artifacts:prepare && npm run contracts:check && npm run contracts:check:workspace && npm run test-context:check && tsc --project tsconfig.json && tsc --project tsconfig.test.json",
    "test:system": "node test/verification/system.ts",
    "test:openspec:convergence": "node --test test/integration/openspec-convergence-transaction.test.ts test/system/task-finish-cli.test.ts && node test/verification/openspec/contract.ts --suite recovery",
    "build:web": "npm run contracts:prepare && npm run contracts:check && npm run contracts:check:workspace && node tools/development/run-development-npm.ts --prefix ../buildr-web run build",
    "dev:web": "npm --prefix ../buildr-web run dev",
    "test:web-dist": "node test/verification/web-dist.ts",
    "test:browser:smoke": "node test/verification/browser-selector-dispatcher.ts --full --run",
    "test:browser:changed": "node test/verification/browser-selector-dispatcher.ts --run",
    "test:browser:core": "node test/verification/browser-selector-dispatcher.ts --selector core --run",
    "test:browser:shell": "node test/verification/browser-selector-dispatcher.ts --selector shell --run",
    "test:browser:project": "node test/verification/browser-selector-dispatcher.ts --selector project --run",
    "test:browser:service": "node test/verification/browser-selector-dispatcher.ts --selector service --run",
    "test:browser:change": "node test/verification/browser-selector-dispatcher.ts --selector change --run",
    "test:browser:task": "node test/verification/browser-selector-dispatcher.ts --selector task --run",
    "test:browser:articles": "node test/verification/browser-selector-dispatcher.ts --selector articles --run",
    "smoke:workspace": "node tools/development/run-isolated-workspace-smoke.ts",
    "test:integration:candidate:release": "node test/verification/run-node-tests.ts test/integration-candidate-release/*.test.ts",
    "coverage:unit": "node test/verification/unit-coverage.ts",
    "test:changed": "node test/verification/changed.ts",
    "test:audit:verification": "node test/verification/audit.ts",
    "test:focus": "node test/verification/focus.ts",
    "test:host-node": "node test/verification/host-node.ts",
    "test:daily-full": "npm run artifacts:prepare && bash test/verification/verify-buildr-product-daily-full",
    "test:core": "npm run artifacts:prepare && bash test/verification/verify-buildr-product-core",
    "test:candidate": "npm run artifacts:prepare && bash test/verification/verify-buildr-product",
    "test:candidate:ci": "bash test/verification/verify-buildr-product-ci",
    "test:candidate:host": "node test/verification/candidate-ci.ts host",
    "test:candidate:aggregate": "node test/verification/candidate-ci.ts aggregate",
    "test:release": "node test/verification/release/release-smoke.ts",
    "test:launcher-platform": "node test/verification/release/release-smoke.ts --platform-launcher",
    "install:development": "./tools/development/install-buildr-development",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "yaml": "^2.9.0"
  },
  "bundleDependencies": [
    "ajv",
    "yaml"
  ],
  "devDependencies": {
    "@fission-ai/openspec": "1.6.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "15.0.4",
    "playwright-core": "^1.61.1",
    "typescript": "7.0.2"
  }
}
