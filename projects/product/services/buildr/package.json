{
  "name": "@buildr-ai/buildr",
  "version": "0.1.0-rc.21",
  "private": false,
  "description": "Buildr CLI for managing Agent workspace assets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildrAI/Buildr.git",
    "directory": "projects/product/services/buildr"
  },
  "homepage": "https://github.com/BuildrAI/Buildr#readme",
  "bugs": {
    "url": "https://github.com/BuildrAI/Buildr/issues"
  },
  "keywords": [
    "agent",
    "agentic-coding",
    "cli",
    "developer-tools",
    "workspace"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "buildr": "bin/buildr.mjs"
  },
  "files": [
    "LICENSE",
    "bin/buildr.mjs",
    "src/",
    "README.md",
    "docs/agent-runtime-adapters.md",
    "docs/cli-reference.md",
    "docs/skill-capability-contracts.md",
    "docs/cli-architecture.md",
    "docs/known-limitations.md",
    "package/README.md",
    "package/manifest.yml",
    "package/bootstrap/",
    "package/targets/"
  ],
  "scripts": {
    "test": "./scripts/verify-buildr-product-fast",
    "test:fast": "./scripts/verify-buildr-product-fast",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:component": "node --test test/component/*.test.mjs",
    "test:contract": "node --test test/contract/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "test:system": "node test/verification/system.mjs",
    "test:openspec:convergence": "node --test test/integration/openspec-convergence-transaction.test.mjs test/system/task-finish-cli.test.mjs && node test/verification/openspec/contract.mjs --suite recovery",
    "build:web": "node scripts/run-development-npm.mjs --prefix ../buildr-web run build",
    "dev:web": "npm --prefix ../buildr-web run dev",
    "test:web-dist": "node test/verification/web-dist.mjs",
    "test:browser:smoke": "npm run test:web-dist && node --test test/browser-smoke/*.test.mjs",
    "test:browser:changed": "node test/verification/browser-selector-dispatcher.mjs --run",
    "test:browser:core": "npm run test:web-dist && node test/browser-smoke/local-app-browser.test.mjs core",
    "test:browser:shell": "npm run test:web-dist && node test/browser-smoke/local-app-browser.test.mjs shell",
    "test:browser:project": "npm run test:web-dist && node test/browser-smoke/local-app-browser.test.mjs project",
    "test:browser:service": "npm run test:web-dist && node test/browser-smoke/local-app-browser.test.mjs service",
    "test:browser:change": "npm run test:web-dist && node test/browser-smoke/local-app-browser.test.mjs change",
    "test:browser:task": "npm run test:web-dist && node test/browser-smoke/local-app-browser.test.mjs task",
    "test:browser:articles": "npm run test:web-dist && node test/browser-smoke/local-app-browser.test.mjs articles",
    "test:integration:candidate:release": "node test/verification/run-node-tests.mjs test/integration-candidate-release/*.test.mjs",
    "coverage:unit": "node test/verification/unit-coverage.mjs",
    "test:changed": "node test/verification/changed.mjs",
    "test:focus": "node test/verification/focus.mjs",
    "test:host-node": "node test/verification/host-node.mjs",
    "test:candidate": "bash scripts/verify-buildr-product",
    "test:candidate:ci": "bash scripts/verify-buildr-product-ci",
    "test:candidate:host": "node test/verification/candidate-ci.mjs host",
    "test:candidate:aggregate": "node test/verification/candidate-ci.mjs aggregate",
    "test:release": "node test/verification/release/release-smoke.mjs",
    "install:development": "./scripts/install-buildr-development",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "bundleDependencies": [
    "yaml"
  ],
  "devDependencies": {
    "@fission-ai/openspec": "1.6.0",
    "esbuild": "0.28.2",
    "playwright-core": "^1.61.1"
  }
}
