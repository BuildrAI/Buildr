{
  "name": "@buildr-ai/buildr",
  "version": "0.1.0-rc.51",
  "buildrCompatibility": {
    "schemaVersion": "buildr.package-compatibility/v1",
    "provides": [
      "buildr.installation-status/v1",
      "buildr.web-protocol/v1",
      "buildr.agent-asset-source-observations/v1",
      "buildr.agent-asset-source-result/v1"
    ],
    "requires": []
  },
  "private": false,
  "description": "Buildr CLI for managing Agent workspace assets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildrAI/Buildr.git",
    "directory": "projects/product/services/buildr"
  },
  "homepage": "https://github.com/BuildrAI/Buildr#readme",
  "bugs": {
    "url": "https://github.com/BuildrAI/Buildr/issues"
  },
  "keywords": [
    "agent",
    "agentic-coding",
    "cli",
    "developer-tools",
    "workspace"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    "./test-context": {
      "types": "./build/test-context/public.d.ts",
      "import": "./build/test-context/public.js",
      "default": "./build/test-context/public.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "bin": {
    "buildr": "bin/buildr.mjs",
    "buildr-mysql": "bin/buildr-mysql.mjs"
  },
  "files": [
    "LICENSE",
    "bin/buildr.mjs",
    "bin/buildr-mysql.mjs",
    "build/test-context/",
    "src/",
    "README.md",
    "docs/agent-runtime-adapters.md",
    "docs/cli-reference.md",
    "docs/skill-capability-contracts.md",
    "docs/cli-architecture.md",
    "docs/known-limitations.md",
    "resources/",
    "resources/runtime/",
    "web-dist/"
  ],
  "scripts": {
    "contracts:generate": "node tools/codegen/contracts/task-dto.ts && node tools/codegen/contracts/task-professional-dto.ts && node tools/codegen/contracts/runtime-system-dto.ts && node tools/codegen/contracts/workbench-dto.ts",
    "contracts:check": "node tools/codegen/contracts/task-dto.ts --check && node tools/codegen/contracts/task-professional-dto.ts --check && node tools/codegen/contracts/runtime-system-dto.ts --check && node tools/codegen/contracts/workbench-dto.ts --check",
    "contracts:generate:workspace": "node tools/codegen/contracts/workspace-agent-assets-dto.ts",
    "contracts:check:workspace": "node tools/codegen/contracts/workspace-agent-assets-dto.ts --check",
    "contracts:prepare": "npm run contracts:generate && npm run contracts:generate:workspace",
    "contracts:professional:generate": "node tools/codegen/contracts/task-professional-dto.ts",
    "contracts:professional:check": "node tools/codegen/contracts/task-professional-dto.ts --check",
    "contracts:generate:runtime-system": "node tools/codegen/contracts/runtime-system-dto.ts && node tools/codegen/contracts/workbench-dto.ts",
    "contracts:check:runtime-system": "node tools/codegen/contracts/runtime-system-dto.ts --check && node tools/codegen/contracts/workbench-dto.ts --check",
    "test-context:generate": "node tools/testing/test-context-build.ts generate",
    "test-context:check": "node tools/testing/test-context-build.ts check",
    "artifacts:prepare": "npm run agent:prepare && npm run contracts:prepare && npm run test-context:generate",
    "candidate:prepare": "node tools/verification/candidate-environment.ts prepare",
    "typecheck": "node tools/testing/run-types.ts --project tsconfig.json",
    "build:web": "npm run contracts:prepare && npm run contracts:check && npm run contracts:check:workspace && node tools/development/run-development-npm.ts --prefix ../buildr-web run build",
    "dev:web": "npm --prefix ../buildr-web run dev",
    "benchmark:task-query-million": "node tools/performance/task-query-million.ts",
    "install:development": "./tools/development/install-buildr-development",
    "pack:check": "npm pack --dry-run",
    "agent:prepare": "node tools/development/prepare-development-agent.ts",
    "postinstall": "node tools/development/prepare-development-agent.ts --no-build",
    "test": "node --import ./test/register-development-entry.ts test/verification/cli.ts unit",
    "check": "node --import ./test/register-development-entry.ts test/verification/cli.ts check",
    "test:static": "node --import ./test/register-development-entry.ts test/verification/cli.ts static",
    "test:integration": "node --import ./test/register-development-entry.ts test/verification/cli.ts integration",
    "test:e2e": "node --import ./test/register-development-entry.ts test/verification/cli.ts e2e",
    "test:related": "node --import ./test/register-development-entry.ts test/verification/cli.ts related",
    "browser:prepare": "playwright-core install chromium --only-shell"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@buildr-ai/buildr-agent": "file:../buildr-agent",
    "@vscode/ripgrep-universal": "1.18.0",
    "ajv": "8.18.0",
    "mysql2": "3.24.5",
    "node-sql-parser": "5.4.0",
    "yaml": "^2.9.0"
  },
  "bundleDependencies": [
    "@vscode/ripgrep-universal",
    "ajv",
    "mysql2",
    "node-sql-parser",
    "yaml",
    "@buildr-ai/buildr-agent"
  ],
  "devDependencies": {
    "@fission-ai/openspec": "1.13.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "15.0.4",
    "playwright-core": "^1.61.1",
    "typescript": "7.0.2"
  }
}
