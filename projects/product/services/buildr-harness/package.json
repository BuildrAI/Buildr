{
  "name": "@buildr-ai/buildr-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Buildr conversations and native Agent execution service.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json",
    "./profile": {
      "types": "./build/profile.d.ts",
      "import": "./build/profile.js",
      "default": "./build/profile.js"
    },
    "./http-dto": {
      "types": "./build/http-dto.d.ts"
    }
  },
  "files": [
    "build/",
    "LICENSE",
    "bin/",
    "resources/"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "node tools/build.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node tools/testing/run-tests.ts 'test/unit/*.test.ts'",
    "test:static": "node tools/testing/run-tests.ts 'test/static/*.test.ts' && npm run typecheck",
    "test:integration": "node tools/testing/run-integration.ts",
    "contracts:generate": "node tools/codegen/http-dto.ts",
    "release:check": "node tools/check-distribution.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-account-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-job-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.2",
    "@qoder-ai/qoder-agent-sdk": "1.0.55",
    "ajv": "8.18.0",
    "cacache": "20.0.4",
    "ws": "8.22.0"
  },
  "overrides": {
    "zod@4.4.3": "4.6.7",
    "undici@8.11.2": "8.12.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "7.0.2"
  },
  "bin": {
    "buildr-harness": "bin/buildr-harness.mjs"
  }
}
