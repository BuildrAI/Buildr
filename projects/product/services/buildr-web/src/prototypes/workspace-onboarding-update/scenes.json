          "position": "flow"
        }
      ],
      "states": [
        {
          "id": "downloading",
          "title": "下载中",
          "notes": []
        },
        {
          "id": "installing",
          "title": "安装中",
          "notes": []
        },
        {
          "id": "restarting",
          "title": "恢复网页",
          "notes": []
        },
        {
          "id": "spaces",
          "title": "自动更新全部空间",
          "notes": [
            {
              "id": "spaces",
              "title": "自动逐个更新",
              "text": "这一步由 Buildr 执行，用户无需手动打开每个空间或运行命令。",
              "position": "workspace-results"
            }
          ]
        },
        {
          "id": "download-error",
          "title": "下载失败",
          "notes": [
            {
              "id": "download",
              "title": "从下载恢复",
              "text": "重新下载保留本次目标，不创建第二次更新。",
              "position": "update-actions"
            }
          ]
        },
        {
          "id": "install-error",
          "title": "安装失败",
          "notes": [
            {
              "id": "install",
              "title": "复用已下载内容",
              "text": "重试安装不重复要求下载或切换更新版本。",
              "position": "update-actions"
            }
          ]
        },
        {
          "id": "reconnect-error",
          "title": "网页恢复失败",
          "notes": [
            {
              "id": "reconnect",
              "title": "保留已安装事实",
              "text": "新版安装已经完成；只恢复网页连接，后续再继续更新空间。",
              "position": "update-actions"
            }
          ]
        },
        {
          "id": "completed",
          "title": "全部完成",
          "notes": [
            {
              "id": "done",
              "title": "实际可用的完成标准",
              "text": "所有空间均准备完毕后显示更新完成。已有对话是否重新读取由宿主决定，需要时给一句明确提示。",
              "position": "workspace-results"
            }
          ]
        }
      ]
    },
    {
      "id": "recovery",
      "title": "失败后的继续处理",
      "notes": [
        {
          "id": "partial",
          "title": "部分失败保留部分成功",
          "text": "已完成空间可以继续工作。全局重试只处理未完成空间，不重新安装软件。",
          "position": "workspace-results"
        },
        {
          "id": "actions",
          "title": "每项独立重试",
          "text": "可以逐个重试，也可以重试全部未完成项。演示假定权限或路径已恢复，重试会成功。",
          "position": "update-actions"
        }
      ],
      "states": [
        {
          "id": "conflict",
          "title": "本地修改冲突",
          "notes": [
            {
              "id": "conflict",
              "title": "真正需要用户决定时才询问",
              "text": "点击查看并处理，比较当前方法与新版。保留修改作为自定义方法，或明确选择新版并保留原内容。单纯重试不会覆盖修改。",
              "position": "workspace-results"
            }
          ]
        },
        {
          "id": "background",
          "title": "收起后继续",
          "notes": [
            {
              "id": "background",
              "title": "在列表接续同一次更新",
              "text": "点击顶部完成更新或列表继续处理可重新查看本次结果。原型在本页内存中保留；正式实现需要跨进程保留。",
              "position": "catalog-banner"
            }
          ]
        },
        {
          "id": "completed",
          "title": "重试后全部完成",
          "notes": []
        }
      ]
    }
  ]
