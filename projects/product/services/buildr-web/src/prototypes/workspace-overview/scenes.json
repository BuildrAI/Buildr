      "title": "工作空间总览",
      "notes": [
        {
          "id": "composition",
          "title": "看清工作空间组成",
          "text": "从项目了解其关联服务及代码位置。共用的对象只显示一次，尚未被项目引用的服务也保留。连线表示已登记的引用关系。",
          "position": "composition"
        },
        {
          "id": "filter",
          "title": "搜索并聚焦项目",
          "text": "输入名称筛选对象，或选择一个项目查看相关组成；清除筛选即可恢复整体视图。",
          "position": "composition-filter"
        },
        {
          "id": "project",
          "title": "直接进入项目组成",
          "text": "点击项目，直接查看这个项目关联的服务和代码库，继续了解它由哪些部分实现。",
          "position": "project-column"
        },
        {
          "id": "detail",
          "title": "就地查看服务详情",
          "text": "点击服务，在右侧查看用途与资料，并可继续打开它的代码库。关闭详情后继续浏览总览。",
          "position": "service-column"
        }
      ],
      "states": [
        {
          "id": "empty",
          "title": "尚无登记",
          "notes": [
            {
              "id": "empty",
              "title": "尚未登记时明确提示",
              "text": "没有登记内容时显示空白提示，不将演示对象当作已登记内容。",
              "position": "composition"
            }
          ]
        },
        {
          "id": "partial",
          "title": "部分信息不可读取",
          "notes": [
            {
              "id": "partial",
              "title": "局部读取失败仍可浏览",
              "text": "保留已经读取的组成信息并提示失败；点击重试重新读取。",
              "position": "composition"
            }
          ]
        }
      ]
    },
    {
