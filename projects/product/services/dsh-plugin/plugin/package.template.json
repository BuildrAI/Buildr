{
  "name": "@buildr-ai/buildr-dsh-plugin",
  "version": "0.1.0-rc.1",
  "private": false,
  "description": "Buildr desktop action for DSH, registered in the shipped sidebar.footer.action seat",
  "repository": { "type": "git", "url": "git+https://github.com/BuildrAI/Buildr.git", "directory": "projects/product/services/dsh-plugin" },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": { "types": "./lib/types/src/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/src/client.d.ts", "default": "./lib/client.js" },
    "./types": { "types": "./lib/types/src/types.d.ts", "default": "./lib/types.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "lib/typert.host.js", "lib/typert.host.d.ts", "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts"],
  "dsh": { "bundle": { "patch": "cordis.patch.yml" }, "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-sidebar-browser", "@deepseek-ai/dsh-api-remotes"] } },
  "peerDependencies": { "@deepseek-ai/cordis": "4.0.4", "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2", "@deepseek-ai/dsh": "0.1.7-rc.2" },
  "dependencies": { "@deepseek-ai/cordis": "4.0.4", "@deepseek-ai/schemastery": "3.18.4", "zod": "4.4.3" },
  "license": "MIT"
}
