+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen, within } from '@testing-library/react'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { TrajectoryTable } from '../src/client/TrajectoryTable.tsx'
+import type { TrajectoryTableProps } from '../src/client/TrajectoryTable.tsx'
+import { t } from './locale.client.ts'
+
+const SID = 'annotations' as SessionId
+const props: TrajectoryTableProps = {
+  t, sessionId: SID, renderImages: () => null,
+  collapsedTurns: new Set(), collapsedAssistants: new Set(),
+  onToggleTurn: () => {}, onToggleAssistant: () => {},
+  turns: [{ turn: 1, groups: [{ title: 'Step 1', cells: [{
+    index: 1, kind: 'tool', text: 'read', callId: 'call-1', eventSeqs: [2, 4],
+    inputDetail: '{"file_path":"AGENTS.md"}', outputDetail: 'original result',
+    timeSeconds: 0.01,
+  }] }] }],
+}
+
+afterEach(() => cleanup())
+
+describe('Official trajectory annotations', () => {
+  it('owns additive columns and preserves the original inspector when contributions leave', () => {
+    const renderSlot: NonNullable<TrajectoryTableProps['renderSlot']> = vi.fn((key, owner, opts) =>
+      key === 'conversation.trajectory.column'
+        ? <span data-testid={`cell-${opts?.only}`}>{owner.record.callId}</span>
+        : <div data-testid="objects">Object linked to {owner.record.callId}</div>)
+    const extensions = {
+      columns: [{ id: 'source', label: 'Source', order: 1 }, { id: 'audit', label: 'Evidence', order: 2 }],
+      hasObjects: true,
+    }
+    const view = render(<TrajectoryTable {...props} renderSlot={renderSlot} extensions={extensions} />)
+    expect(screen.getAllByRole('columnheader')).toHaveLength(4)
+    const row = view.container.querySelector('tbody tr')
+    expect(row?.querySelectorAll('td')).toHaveLength(4)
+    expect(screen.getByTestId('cell-source').textContent).toBe('call-1')
+    expect(screen.getByTestId('cell-audit').textContent).toBe('call-1')
+    fireEvent.click(screen.getByText('read'))
+    const inspector = screen.getByRole('complementary', { name: 'Event details' })
+    expect(within(inspector).getByTestId('objects').textContent).toContain('call-1')
+    expect(within(inspector).getByRole('tab', { name: t('tab.payload') })).toBeTruthy()
+    view.rerender(<TrajectoryTable {...props} renderSlot={renderSlot}
+      extensions={{ columns: [], hasObjects: false }} />)
+    expect(screen.queryAllByRole('columnheader')).toHaveLength(0)
+    expect(view.container.querySelector('tbody tr')?.querySelectorAll('td')).toHaveLength(2)
+    expect(screen.queryByTestId('objects')).toBeNull()
+    expect(screen.getByRole('complementary', { name: 'Event details' })).toBe(inspector)
+  })
+
+  it('uses the same dynamic span for history and virtual spacer rows', () => {
+    const view = render(<TrajectoryTable {...props} hasOlderRecords
+      onLoadOlder={() => Promise.resolve(false)} renderSlot={() => null}
+      extensions={{ columns: [{ id: 'source', label: 'Source', order: 0 }], hasObjects: false }} />)
+    expect(view.container.querySelector('[data-history-load] td')?.getAttribute('colspan')).toBe('3')
+    view.rerender(<TrajectoryTable {...props} hasOlderRecords
+      onLoadOlder={() => Promise.resolve(false)} renderSlot={() => null}
+      extensions={{ columns: [], hasObjects: false }} />)
+    expect(view.container.querySelector('[data-history-load] td')?.getAttribute('colspan')).toBe('2')
+  })
+})
