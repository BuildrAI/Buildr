@@ -0,0 +1,68 @@
+/** JSON owner data for annotations on the original Trajectory records. */
+import type { Branded } from '@deepseek-ai/dsh-brand'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { TrajectoryCellKind } from './trajectory-record.ts'
+
+/** One loaded durable event; seq is a non-negative safe integer, never a layout anchor. */
+export interface TrajectoryEventRef {
+  readonly sessionId: SessionId
+  readonly seq: number
+}
+
+/** JSON-tuple encoded identity from a producer-owned call, event, or assistant lifecycle; contains no control characters. */
+export type TrajectoryRecordId = Branded<'TrajectoryRecordId'>
+
+/** Stable record identity and original event addresses; contains no content or executable values. */
+export interface TrajectoryRecordContext {
+  readonly recordId: TrajectoryRecordId
+  readonly kind: TrajectoryCellKind
+  readonly eventRefs: readonly TrajectoryEventRef[]
+  readonly callId?: string
+  readonly parentCallId?: string
+  readonly rootCallId?: string
+  /** True when the record has no durable event evidence in the current loaded window. */
+  readonly transient: boolean
+}
+
+/** Event addresses and call ancestry retained by the Trajectory-owned Tool projection. */
+export interface TrajectoryToolEventSource {
+  readonly callId: string
+  readonly eventSeqs: readonly number[]
+  readonly parentCallId?: string
+  readonly rootCallId: string
+}
+
+/** One active list contribution; the official table owns its th, td, and column width. */
+export interface TrajectoryColumn {
+  readonly id: string
+  readonly order: number
+  readonly label: string
+}
+
+/** Entry-private JSON roster synthesized from live Slot winners. */
+export interface TrajectoryExtensionState {
+  readonly columns: readonly TrajectoryColumn[]
+  readonly hasObjects: boolean
+}
+
+/** Owner values supplied for one record annotation occurrence. */
+export interface TrajectoryRecordOwner {
+  readonly record: TrajectoryRecordContext
+}
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface SlotMap {
+    /** Additive record cells; id/order/label declare the official table column. */
+    'conversation.trajectory.column': {
+      kind: 'list'
+      scope: 'session'
+      owner: TrajectoryRecordOwner
+    }
+    /** Additive objects below the original inspector's overview; existing tabs remain owned by Trajectory. */
+    'conversation.trajectory.inspector.objects': {
+      kind: 'list'
+      scope: 'session'
+      owner: TrajectoryRecordOwner
+    }
+  }
+}
diff --git a/packages/client/ui-trajectory/src/client/trajectory-extensions.ts b/packages/client/ui-trajectory/src/client/trajectory-extensions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9abb9bf82d8fad4ff783610ecf350a1668bb5f8b
--- /dev/null
+++ b/packages/client/ui-trajectory/src/client/trajectory-extensions.ts
@@ -0,0 +1,74 @@
+/** Original-record addresses and entry-private extension roster. */
+import { resolveSlotLabel } from '@deepseek-ai/dsh-client-ui-slots'
+import type { StoredEntry } from '@deepseek-ai/dsh-client-ui-slots'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { TrajectoryCellProps } from './trajectory-record.ts'
+import type {
+  TrajectoryColumn, TrajectoryExtensionState, TrajectoryRecordContext, TrajectoryRecordId,
+} from './trajectory-extension-contract.ts'
+
+/** Empty roster preserves the shipped two-column ledger and inspector. */
+export const EMPTY_TRAJECTORY_EXTENSIONS: TrajectoryExtensionState = {
+  columns: [],
+  hasObjects: false,
+}
+
+/**
+ * Project winning list entries into the table's JSON metadata in render order.
+ * @param entries - Current live list winners, in registration order.
+ * @returns Column labels without components, thunks, or registry objects.
+ */
+export function trajectoryColumns(entries: readonly StoredEntry[]): readonly TrajectoryColumn[] {
+  return entries.flatMap(entry => entry.options.id === undefined ? [] : [{
+    id: entry.options.id,
+    order: entry.options.order ?? 0,
+    label: resolveSlotLabel(entry.options.label) ?? entry.options.id,
+  }]).sort((left, right) => left.order - right.order)
+}
+
+/**
+ * Compare the annotation roster without treating registry revision as new data.
+ * @param left - Previously published metadata.
+ * @param right - Newly resolved metadata.
+ * @returns Whether the table structure and displayed labels are unchanged.
+ */
+export function sameTrajectoryExtensions(
+  left: TrajectoryExtensionState,
+  right: TrajectoryExtensionState,
+): boolean {
+  return left.hasObjects === right.hasObjects && left.columns.length === right.columns.length
+    && left.columns.every((column, index) => {
+      const next = right.columns[index]
+      return next !== undefined && column.id === next.id
+        && column.order === next.order && column.label === next.label
+    })
+}
+
+/**
+ * Resolve public annotation data without exposing the table's index fallback.
+ * @param sessionId - Owning logical Session.
+ * @param cell - Original projected record.
+ * @returns JSON record identity, or undefined for unaddressed fixture-only cells.
+ */
+export function trajectoryRecordContext(
+  sessionId: SessionId,
+  cell: TrajectoryCellProps,
+): TrajectoryRecordContext | undefined {
+  const rawSeqs = cell.eventSeqs ?? (cell.transient === true || cell.sourceSeq === undefined
+    ? [] : [cell.sourceSeq])
+  const seqs = [...new Set(rawSeqs.filter(seq => Number.isSafeInteger(seq) && seq >= 0))]
+    .sort((left, right) => left - right)
+  const recordId = cell.recordId ?? (cell.callId === undefined
+    ? seqs[0] === undefined ? undefined : `${cell.kind}\u0000seq\u0000${seqs[0]}`
+    : `${cell.kind}\u0000call\u0000${cell.callId}`)
+  if (recordId === undefined || cell.requestOnly === true) return undefined
+  return {
+    recordId: JSON.stringify(['trajectory-record', recordId]) as TrajectoryRecordId,
+    kind: cell.kind,
+    eventRefs: seqs.map(seq => ({ sessionId, seq })),
+    ...(cell.callId === undefined ? {} : { callId: cell.callId }),
+    ...(cell.parentCallId === undefined ? {} : { parentCallId: cell.parentCallId }),
+    ...(cell.rootCallId === undefined ? {} : { rootCallId: cell.rootCallId }),
+    transient: seqs.length === 0,
+  }
+}
