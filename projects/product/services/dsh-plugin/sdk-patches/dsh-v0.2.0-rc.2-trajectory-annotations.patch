@@ -0,0 +1,96 @@
+import { describe, expect, it } from 'vitest'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { StoredEntry } from '@deepseek-ai/dsh-client-ui-slots'
+import type { TrajectoryCellProps } from '../src/client/trajectory-record.ts'
+import { sameTrajectoryExtensions, trajectoryColumns, trajectoryRecordContext } from '../src/client/trajectory-extensions.ts'
+
+const SID = 'record-session' as SessionId
+const tool: TrajectoryCellProps = {
+  index: 9, kind: 'tool', text: 'read', callId: 'c1', timeSeconds: null,
+}
+
+describe('Trajectory annotation data', () => {
+  it('keeps call identity and loaded raw addresses after history prepending', () => {
+    const cell = { ...tool, eventSeqs: [12, 8, 12], rootCallId: 'c1' }
+    const record = trajectoryRecordContext(SID, cell)
+    expect(record).toEqual({
+      recordId: JSON.stringify(['trajectory-record', 'tool\u0000call\u0000c1']), kind: 'tool',
+      eventRefs: [{ sessionId: SID, seq: 8 }, { sessionId: SID, seq: 12 }],
+      callId: 'c1', rootCallId: 'c1', transient: false,
+    })
+    expect(trajectoryRecordContext(SID, { ...cell, index: 90 })).toEqual(record)
+    expect(JSON.parse(JSON.stringify(record))).toEqual(record)
+  })
+
+  it('publishes transport-safe identities for every original kind and observation suffix', () => {
+    const kinds = ['system', 'user', 'context', 'compacted', 'message', 'tool', 'subtool'] as const
+    for (const kind of kinds) {
+      const cell: TrajectoryCellProps = {
+        index: 3, kind, text: '', timeSeconds: null, sourceSeq: 8,
+        ...(kind === 'message' ? { recordId: 'assistant\u00001\u00002' } : {}),
+        ...(kind === 'tool' || kind === 'subtool' ? { callId: 'call-1' } : {}),
+      }
+      const record = trajectoryRecordContext(SID, cell)
+      if (record === undefined) throw new Error('record is not addressable')
+      const observationId = `${record.recordId}:event:${SID}:8:0`
+      // The source-reader wire contract treats both identifiers as bounded opaque text.
+      for (const id of [record.recordId, observationId]) {
+        expect(id).not.toMatch(/\0/)
+        expect(Buffer.byteLength(id)).toBeLessThanOrEqual(4096)
+        expect(id.length).toBeGreaterThan(0)
+      }
+      expect(trajectoryRecordContext(SID, { ...cell, index: 300 })?.recordId).toBe(record.recordId)
+      expect(record.eventRefs).toEqual([{ sessionId: SID, seq: 8 }])
+      expect(JSON.parse(record.recordId)[0]).toBe('trajectory-record')
+    }
+  })
+
+  it('never converts a synthetic ordering anchor into a durable event address', () => {
+    const record = trajectoryRecordContext(SID, { ...tool, sourceSeq: 12.2 })
+    expect(record?.eventRefs).toEqual([])
+    expect(record?.transient).toBe(true)
+    const live = trajectoryRecordContext(SID, {
+      index: 1, kind: 'message', text: '', timeSeconds: null,
+      recordId: 'assistant\u00001\u00002', sourceSeq: Number.MAX_SAFE_INTEGER, transient: true,
+    })
+    expect(live?.eventRefs).toEqual([])
+    expect(live?.recordId).toBe(JSON.stringify(['trajectory-record', 'assistant\u00001\u00002']))
+  })
+
+  it('does not publish index-only identities or request separator rows', () => {
+    expect(trajectoryRecordContext(SID, {
+      index: 1, kind: 'context', text: '', timeSeconds: null,
+    })).toBeUndefined()
+    expect(trajectoryRecordContext(SID, { ...tool, requestOnly: true })).toBeUndefined()
+  })
+
+  it('retains nested call ancestry without copying result content or metadata', () => {
+    expect(trajectoryRecordContext(SID, {
+      ...tool, kind: 'subtool', parentCallId: 'parent', rootCallId: 'root', eventSeqs: [4, 6],
