+import { expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { ToolCallId } from '@deepseek-ai/dsh-llm'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineTool, type EventSourceHint } from '@deepseek-ai/dsh-tools'
+import type { EventSources } from '@deepseek-ai/dsh-session/types'
+
+const hint: EventSourceHint = { kind: 'skill', action: 'load', name: 'test-method', locator: { path: '/test/SKILL.md' }, content: 'PROCESS ONLY BODY', completeness: 'complete' }
+const sources: EventSources = { schemaVersion: 'dsh.event-sources/v1', status: 'confirmed', matches: [{ providedBy: 'buildr', kind: 'skill', identity: 'product:test-method', name: 'test-method', locator: { path: '/test/SKILL.md' }, observedVersion: { algorithm: 'sha256', digest: 'a'.repeat(64), target: 'file' }, evidence: [{ authority: 'test-receipt', identity: 'product:test-method' }], action: 'load', completeness: 'complete' }] }
+async function setup(timeout = 5000) {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime, { sourceCaptureTimeoutMs: timeout })
+  return ctx
+}
+function tool(fail = false) {
+  return defineTool({
+    name: 'source-test', description: '', parameters: {},
+    output: { schema: { type: 'string' }, render: (_args, value) => [{ type: 'text', text: value }], presentationMeta: () => ({ original: true }) },
+    async execute(_args, exec) { await exec.captureSource(hint); if (fail) throw new Error('original failure'); return 'original result' },
+  })
+}
+const input = () => ({ name: 'source-test', callId: ToolCallId('source-test-call'), arguments: {}, signal: new AbortController().signal })
+
+it('preserves captured sources separately from canonical value, model content and original presentation metadata', async () => {
+  const ctx = await setup()
+  try {
+    ctx.on('tools/source-capture', async request => { expect(request.hint.content).toBe('PROCESS ONLY BODY'); return sources })
+    ctx.tools.register(tool())
+    const result = await ctx.tools.execute(input())
+    expect(result.isError).toBe(false)
+    expect(result.value).toBe('original result')
+    expect(result.content).toEqual([{ type: 'text', text: 'original result' }])
+    expect(result.meta).toEqual({ original: true })
+    expect(result.eventSources).toEqual(sources)
+    expect(JSON.stringify(result.eventSources)).not.toContain('PROCESS ONLY BODY')
+    expect(Object.isFrozen(result.eventSources)).toBe(true)
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('keeps captured sources when the native tool, content finalizer, or later policy fails', async () => {
+  for (const failure of ['execute', 'finalize', 'policy']) {
+    const ctx = await setup()
+    try {
+      ctx.on('tools/source-capture', async () => sources)
+      const definition = tool(failure === 'execute')
+      ctx.tools.register(failure === 'finalize' ? { ...definition, finalizeContent: () => { throw new Error('content finalizer failed') } } : definition)
+      if (failure === 'policy') ctx.on('tools/post-execute', async () => ({ kind: 'block', feedback: [{ type: 'text', text: 'policy blocked' }] }))
+      const result = await ctx.tools.execute(input())
+      expect(result.isError).toBe(true)
+      expect(result.eventSources).toEqual(sources)
+      expect(result.content).toEqual([{ type: 'text', text: failure === 'execute' ? 'Error: original failure' : failure === 'finalize' ? 'Error: content finalizer failed' : 'policy blocked' }])
+    } finally { await ctx.fiber.dispose() }
+  }
+})
+
+it('contains optional provider failures and expiry without replacing a successful tool outcome', async () => {
+  for (const expiry of [false, true]) {
+    const ctx = await setup(15)
+    try {
+      ctx.on('tools/source-capture', async () => { if (expiry) return new Promise(() => {}); throw new Error('private capture failure') })
+      ctx.tools.register(tool())
+      const result = await ctx.tools.execute(input())
+      expect(result.isError).toBe(false)
+      expect(result.content).toEqual([{ type: 'text', text: 'original result' }])
+      expect(result.eventSources?.status).toBe('unknown')
+      expect(result.eventSources?.diagnostics).toEqual([{ code: expiry ? 'capture-timeout' : 'capture-provider-failed' }])
+      expect(JSON.stringify(result.eventSources)).not.toContain('private')
+    } finally { await ctx.fiber.dispose() }
+  }
+})
+
+it('does not inherit parent source identity in a nested execution', async () => {
+  const ctx = await setup()
+  try {
+    ctx.on('tools/source-capture', async request => ({ ...sources, matches: sources.matches.map(match => ({ ...match, identity: request.hint.name })) }))
+    ctx.tools.register(tool())
+    ctx.tools.register(defineTool({
+      name: 'parent-source', description: '', parameters: {}, output: { schema: { type: 'string' }, render: (_args, value) => [{ type: 'text', text: value }] },
+      async execute(_args, exec) {
+        await exec.captureSource({ ...hint, name: 'parent' })
+        const child = await ctx.tools.execute({ ...input(), rootCallId: exec.rootCallId, parent: exec.token })
+        expect(child.eventSources?.matches.map(match => match.identity)).toEqual(['test-method'])
+        return 'parent result'
+      },
+    }))
+    const result = await ctx.tools.execute({ ...input(), name: 'parent-source' })
+    expect(result.eventSources?.matches.map(match => match.identity)).toEqual(['parent'])
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('strips undeclared nested raw bodies and rejects invalid digests without rejecting execution', async () => {
+  const ctx = await setup()
+  try {
+    const match = sources.matches[0]!
+    const provider = { ...sources, matches: [{ ...match,
+      locator: { path: '/test/SKILL.md', body: 'RAW BODY' },
+      evidence: [{ authority: 'receipt', identity: 'method', content: 'RAW BODY' }],
+      targets: [{ kind: 'file' as const, id: '/test/SKILL.md', body: 'RAW BODY' }],
+      contentRefs: [{ block: 0, start: 0, end: 1, unit: 'utf16' as const, body: 'RAW BODY' }],
+    }] }
+    ctx.on('tools/source-capture', async () => provider)
+    ctx.tools.register(tool())
+    const first = await ctx.tools.execute(input())
+    expect(first.isError).toBe(false)
+    expect(first.eventSources?.status).toBe('confirmed')
+    expect(JSON.stringify(first.eventSources)).not.toContain('RAW BODY')
+    provider.matches[0]!.observedVersion = { algorithm: 'sha256', digest: 'not-a-digest', target: 'file' }
+    const second = await ctx.tools.execute(input())
+    expect(second.isError).toBe(false)
+    expect(second.eventSources?.diagnostics).toEqual([{ code: 'capture-metadata-invalid' }])
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('keeps observed process outcomes separate from source confirmation and from enclosing executions', async () => {
+  const ctx = await setup()
+  try {
+    ctx.on('tools/source-capture', async () => sources)
+    ctx.tools.register(defineTool({
+      name: 'source-test', description: '', parameters: {},
+      output: { schema: { type: 'string' }, render: (_args, value) => [{ type: 'text', text: value }] },
+      async execute(_args, exec) { await exec.captureSource(hint); exec.recordSourceOutcome({ outcome: 'failed', exitCode: 3 }); return 'native success' },
+    }))
+    ctx.tools.register(defineTool({
+      name: 'parent-source', description: '', parameters: {},
+      output: { schema: { type: 'string' }, render: (_args, value) => [{ type: 'text', text: value }] },
+      async execute(_args, exec) {
+        exec.recordSourceOutcome({ outcome: 'unknown' })
+        const child = await ctx.tools.execute({ ...input(), rootCallId: exec.rootCallId, parent: exec.token })
+        expect(child.isError).toBe(false)
+        expect(child.eventSources).toEqual({ ...sources, execution: { outcome: 'failed', exitCode: 3 } })
+        return 'parent success'
+      },
+    }))
+    const parent = await ctx.tools.execute({ ...input(), name: 'parent-source' })
+    expect(parent.isError).toBe(false)
+    expect(parent.eventSources?.status).toBe('unknown')
+    expect(parent.eventSources?.matches).toEqual([])
+    expect(parent.eventSources?.execution).toEqual({ outcome: 'unknown' })
+  } finally { await ctx.fiber.dispose() }
+})
