new file mode 100644
index 0000000000000000000000000000000000000000..753898530e055f9e51f2cb1ff13fca2a7f9dc695
--- /dev/null
+++ b/packages/core/tools/src/source-capture.ts
@@ -0,0 +1,162 @@
+/** Producer observations used only while resolving small durable source metadata. */
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type { ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { EventSources, EventSourceReference, EventSourceExecution } from '@deepseek-ai/dsh-session/types'
+
+/** Actual producer input; raw content and command text never become event source metadata. */
+export interface EventSourceHint {
+  readonly kind: 'rule' | 'skill' | 'read' | 'command' | 'capability'
+  readonly action: 'load' | 'replace' | 'remove' | 'read' | 'call'
+  readonly name: string
+  readonly locator?: { readonly path?: string; readonly entry?: string; readonly provider?: string; readonly resourceBase?: string }
+  readonly rawDigest?: { readonly algorithm: 'sha256'; readonly digest: string }
+  readonly content?: string
+  readonly renderedContent?: string
+  /** Actual injected prefix in the original rule file, before framing escape; process-only UTF16 range. */
+  readonly ruleWindow?: { readonly start: number; readonly end: number }
+  readonly readWindow?: { readonly offset: number; readonly totalLines: number; readonly lines: readonly { readonly number: number; readonly text: string; readonly start?: number; readonly end?: number }[] }
+  readonly contentRefs?: readonly EventSourceReference[]
+  readonly completeness: 'complete' | 'partial' | 'none'
+  readonly command?: { readonly text: string; readonly cwd?: string }
+  readonly priorSources?: EventSources
+}
+/** Execution-owned request delivered to the source-capture provider. */
+export interface EventSourceCaptureRequest {
+  readonly hint: EventSourceHint
+  readonly agent?: Agent
+  readonly callId?: ToolCallId
+  readonly rootCallId?: ToolCallId
+  readonly signal: AbortSignal
+}
+/** Options for source capture outside a tool execution, such as an injected context. */
+export interface EventSourceCaptureOptions {
+  readonly callId?: ToolCallId
+  readonly rootCallId?: ToolCallId
+  readonly agent?: Agent
+  readonly signal: AbortSignal
+}
+
+/**
+ * A failed optional capture never changes the native execution outcome.
+ * @param code - static diagnostic identifying the failed capture.
+ * @returns small unknown metadata with no source body.
+ */
+export function unknownEventSources(code: string): EventSources {
+  return { schemaVersion: 'dsh.event-sources/v1', status: 'unknown', matches: [], diagnostics: [{ code }] }
+}
+/**
+ * Merge independent captures from one producer, without inheriting parent execution facts.
+ * @param values - this producer's independently captured source facts.
+ * @returns merged bounded metadata, or undefined when this producer captured nothing.
+ */
+export function mergeEventSources(values: readonly EventSources[]): EventSources | undefined {
+  if (values.length === 0) return undefined
+  const matches = [...new Map(values.flatMap(value => value.matches).map(match => [JSON.stringify(match), match])).values()]
+  const diagnostics = [...new Set(values.flatMap(value => value.diagnostics?.map(item => item.code) ?? []))].map(code => ({ code }))
+  const execution = values.findLast(value => value.execution !== undefined)?.execution
+  const result: EventSources = {
+    schemaVersion: 'dsh.event-sources/v1',
+    status: matches.length > 0 ? 'confirmed' : values.some(value => value.status === 'unknown') ? 'unknown' : 'not-applicable',
+    matches,
+    ...execution === undefined ? {} : { execution },
+    ...values.some(value => value.mixed === true) ? { mixed: true } : {},
+    ...diagnostics.length > 0 ? { diagnostics } : {},
+  }
+  return matches.length > 32 || Buffer.byteLength(JSON.stringify(result)) > 65_536 ? unknownEventSources('capture-metadata-limit') : result
+}
+
+function sourceObject(value: unknown): Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) throw new TypeError('invalid source metadata')
+  return value as Record<string, unknown>
+}
+function sourceText(value: unknown, max = 4096): string {
+  if (typeof value !== 'string' || !value || /[\u0000-\u001f]/.test(value) || value.length > max) throw new TypeError('invalid source text')
+  return value
+}
+function sourceList(value: unknown, max: number): unknown[] {
+  if (!Array.isArray(value) || value.length > max) throw new TypeError('invalid source list')
+  return value
+}
+function sourceChoice<T extends string>(value: unknown, choices: readonly T[]): T {
+  if (typeof value !== 'string' || !choices.includes(value as T)) throw new TypeError('invalid source choice')
+  return value as T
+}
+function sourceInteger(value: unknown): number {
+  if (!Number.isSafeInteger(value) || Number(value) < 0) throw new TypeError('invalid source reference')
+  return Number(value)
+}
+/**
+ * Select declared source fields and validate the JSON metadata returned by an optional provider.
+ * @param value - provider result, whose live request may contain unrelated raw content.
+ * @returns detached small fields, or unknown without rejecting the original execution.
+ */
+export function snapshotCapturedEventSources(value: unknown): EventSources {
+  try {
+    const input = sourceObject(value)
+    if (input.schemaVersion !== 'dsh.event-sources/v1') throw new TypeError('invalid source version')
+    const status = sourceChoice(input.status, ['confirmed', 'unknown', 'not-applicable'] as const)
+    const matches = sourceList(input.matches, 32).map(raw => {
+      const match = sourceObject(raw)
+      const locator = match.locator === undefined ? undefined : sourceObject(match.locator)
+      const version = match.observedVersion === undefined ? undefined : sourceObject(match.observedVersion)
+      const algorithm = version === undefined ? undefined : sourceChoice(version.algorithm, ['sha1', 'sha256'] as const)
+      const digest = version === undefined ? undefined : sourceText(version.digest)
+      if (digest !== undefined && !(algorithm === 'sha1' ? /^[a-f0-9]{40}$/ : /^[a-f0-9]{64}$/).test(digest)) throw new TypeError('invalid source digest')
+      const references = match.contentRefs === undefined ? undefined : sourceList(match.contentRefs, 32).map(rawReference => {
+        const reference = sourceObject(rawReference), start = sourceInteger(reference.start), end = sourceInteger(reference.end)
+        if (end < start) throw new TypeError('invalid source range')
+        return { block: sourceInteger(reference.block), start, end, unit: sourceChoice(reference.unit, ['utf16'] as const) }
+      })
+      return {
+        providedBy: sourceText(match.providedBy, 128), kind: sourceChoice(match.kind, ['rule', 'skill', 'capability'] as const),
+        identity: sourceText(match.identity), name: sourceText(match.name, 512),
+        ...locator === undefined ? {} : { locator: {
+          ...locator.path === undefined ? {} : { path: sourceText(locator.path) },
+          ...locator.entry === undefined ? {} : { entry: sourceText(locator.entry) },
+          ...locator.workspaceId === undefined ? {} : { workspaceId: sourceText(locator.workspaceId) },
+          ...locator.scope === undefined ? {} : { scope: sourceText(locator.scope) },
+        } },
+        ...version === undefined || algorithm === undefined || digest === undefined ? {} : { observedVersion: { algorithm, digest, target: sourceChoice(version.target, ['file', 'content', 'entry'] as const) } },
+        evidence: sourceList(match.evidence, 32).map(rawEvidence => {
+          const evidence = sourceObject(rawEvidence)
+          return { authority: sourceText(evidence.authority, 256), identity: sourceText(evidence.identity), ...evidence.digest === undefined ? {} : { digest: sourceText(evidence.digest, 256) } }
+        }),
+        ...match.action === undefined ? {} : { action: sourceChoice(match.action, ['load', 'replace', 'remove', 'read', 'call'] as const) },
+        ...match.operation === undefined ? {} : { operation: sourceText(match.operation, 512) },
+        ...match.targets === undefined ? {} : { targets: sourceList(match.targets, 32).map(rawTarget => {
+          const target = sourceObject(rawTarget)
+          return { kind: sourceChoice(target.kind, ['task', 'material', 'file', 'capability'] as const), id: sourceText(target.id), ...target.title === undefined ? {} : { title: sourceText(target.title, 512) } }
+        }) },
+        ...references === undefined ? {} : { contentRefs: references },
+        completeness: sourceChoice(match.completeness, ['complete', 'partial', 'none'] as const),
+      }
+    })
+    if (status === 'confirmed' ? matches.length === 0 : matches.length !== 0) throw new TypeError('invalid source status')
+    if (matches.some(match => match.evidence.length === 0)) throw new TypeError('missing source evidence')
+    if (input.mixed !== undefined && typeof input.mixed !== 'boolean') throw new TypeError('invalid mixed sources')
+    const result: EventSources = {
+      schemaVersion: 'dsh.event-sources/v1', status, matches,
+      ...input.mixed === undefined ? {} : { mixed: input.mixed },
+      ...input.diagnostics === undefined ? {} : { diagnostics: sourceList(input.diagnostics, 32).map(rawDiagnostic => {
+        const code = sourceText(sourceObject(rawDiagnostic).code)
+        if (!/^[a-z][a-z0-9_-]{0,63}$/.test(code)) throw new TypeError('invalid source diagnostic')
+        return { code }
+      }) },
+    }
+    return Buffer.byteLength(JSON.stringify(result)) > 65_536 ? unknownEventSources('capture-metadata-limit') : result
+  } catch (error: unknown) { return unknownEventSources('capture-metadata-invalid') }
+}
+
+/**
+ * Keep only observed process fields; invalid values remain unknown without failing the native tool.
+ * @param value - executor-owned process outcome.
+ * @returns small structural facts for this execution only.
+ */
+export function snapshotSourceExecution(value: unknown): EventSourceExecution {
+  try {
+    const data = sourceObject(value)
+    const outcome = sourceChoice(data.outcome, ['succeeded', 'failed', 'unknown'] as const)
+    if (data.exitCode !== undefined && !Number.isSafeInteger(data.exitCode)) throw new TypeError('invalid source exit code')
+    return { outcome, ...data.exitCode === undefined ? {} : { exitCode: Number(data.exitCode) } }
+  } catch (error: unknown) { return { outcome: 'unknown' } }
+}
