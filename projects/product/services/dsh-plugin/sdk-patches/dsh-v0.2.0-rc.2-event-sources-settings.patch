+/** Small immutable source facts captured by the producer of a durable event. */
+export interface EventSourceReference {
+  readonly block: number
+  readonly start: number
+  readonly end: number
+  readonly unit: 'utf16'
+}
+/** Actual source version; file, injected content, and executable digests are distinct. */
+export interface EventSourceVersion {
+  readonly algorithm: 'sha1' | 'sha256'
+  readonly digest: string
+  readonly target: 'file' | 'content' | 'entry'
+}
+/** One provider-owned asset or capability participating in the event. */
+export interface EventSourceMatch {
+  readonly providedBy: string
+  readonly kind: 'rule' | 'skill' | 'capability'
+  readonly identity: string
+  readonly name: string
+  readonly locator?: { readonly path?: string; readonly entry?: string; readonly workspaceId?: string; readonly scope?: string }
+  readonly observedVersion?: EventSourceVersion
+  readonly evidence: readonly { readonly authority: string; readonly identity: string; readonly digest?: string }[]
+  readonly operation?: string
+  readonly targets?: readonly { readonly kind: 'task' | 'material' | 'file' | 'capability'; readonly id: string; readonly title?: string }[]
+  readonly action?: 'load' | 'replace' | 'remove' | 'read' | 'call'
+  readonly contentRefs?: readonly EventSourceReference[]
+  readonly completeness: 'complete' | 'partial' | 'none'
+}
+/** Process outcome observed by the executor, independent of source ownership and task completion. */
+export interface EventSourceExecution {
+  readonly outcome: 'succeeded' | 'failed' | 'unknown'
+  readonly exitCode?: number
+}
+/** Absence means uncollected; unknown is an explicit unsuccessful source capture. */
+export interface EventSources {
+  readonly schemaVersion: 'dsh.event-sources/v1'
+  readonly status: 'confirmed' | 'unknown' | 'not-applicable'
+  readonly matches: readonly EventSourceMatch[]
+  readonly execution?: EventSourceExecution
+  readonly mixed?: boolean
+  readonly diagnostics?: readonly { readonly code: string }[]
+}
