+    const result = session.append('tool/result', { turn: 1, step: 1, message: createToolResultMessage({ callId: ToolCallId('root'), content: [{ type: 'text', text: 'Private parent output stays in its original event' }], isError: false }), meta: { original: 'untouched' }, eventSources: ordinary }, { surfaceOp: 'append' })
+    const rootLive = await iterator.next()
+    if (rootLive.done || rootLive.value.type !== 'event') throw new Error('Expected parent original live event')
+    client.append(historyEntries([JSON.parse(JSON.stringify(rootLive.value)) as Extract<SessionFollowFrame, { type: 'event' }>])[0]!)
+    client.flush()
+    const page = JSON.parse(JSON.stringify(await history.page({ address: { kind: 'session', sessionId: session.id }, throughSeq: session.seq - 1 }, new AbortController().signal))) as SessionPage
+    const cold = assembler(historyEntries(page.records))
+    const recordsFor = (value: ConversationNodeAssembler) => {
+      const current = snapshot(value)
+      return deriveTrajectoryLayout({ ...current, nodes: current.eventNodes }, key => key).flatMap(turn => turn.groups.flatMap(group => group.cells.flatMap(cell => { const record = trajectoryRecordContext(session.id, cell); return record ? [record] : [] })))
+    }
+    const liveRecords = recordsFor(client), coldRecords = recordsFor(cold)
+    expect(coldRecords).toEqual(liveRecords)
+    expect(liveRecords.find(record => record.kind === 'context')?.eventSources).toEqual([{ seq: injection.seq, sources: method, outcome: 'succeeded' }])
+    expect(liveRecords.find(record => record.callId === 'child')).toMatchObject({ kind: 'subtool', parentCallId: 'root', rootCallId: 'root', eventSources: [{ seq: child.seq, sources: capability, outcome: 'failed' }] })
+    expect(liveRecords.find(record => record.callId === 'root')?.eventSources).toEqual([{ seq: result.seq, sources: ordinary, outcome: 'succeeded' }])
+    const wireInjection = page.records.find(record => record.event.seq === injection.seq)?.event
+    if (!wireInjection || wireInjection.type !== 'user/message') throw new Error('Missing original injected event')
+    const original = (wireInjection.data as { content: { type: string; text: string }[] }).content[0]!.text
+    const ref = method.matches[0]!.contentRefs[0]!
+    expect(original.slice(ref.start, ref.end)).toBe(methodBody)
+    expect(JSON.stringify(liveRecords)).not.toContain(methodBody)
+    expect(JSON.stringify(liveRecords)).not.toContain('Private parent output')
+    expect(page.records.find(record => record.event.seq === result.seq)?.event.data).toMatchObject({ meta: { original: 'untouched' } })
+  } finally {
+    abort.abort()
+    await iterator.return?.()
+    await ctx.fiber.dispose()
+  }
+})
