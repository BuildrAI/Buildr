+/** Identity-only tar inspection is bounded and never invokes package code. */
+import { createWriteStream, mkdtempSync, rmSync, truncateSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Readable } from 'node:stream'
+import { pipeline } from 'node:stream/promises'
+import { createGzip, gzipSync } from 'node:zlib'
+import { expect, it, onTestFinished } from 'vitest'
+import { checkBuildrInstall } from '../src/buildr-install.ts'
+import { tarball, tarMember } from './tar-fixture.ts'
+
+const BUILDR = '@buildr-ai/buildr-dsh-plugin'
+function fixture() {
+  const dir = mkdtempSync(join(tmpdir(), 'buildr-install-identity-'))
+  onTestFinished(() => { rmSync(dir, { recursive: true, force: true }) })
+  return { dir, archive: join(dir, 'renamed.tgz'), installed: { dependencies: { [BUILDR]: '1.0.0' } } }
+}
+function paxRecord(path: string): Buffer {
+  const body = `path=${path}\n`
+  let length = Buffer.byteLength(body) + 2
+  while (Buffer.byteLength(`${length} ${body}`) !== length) length = Buffer.byteLength(`${length} ${body}`)
+  return Buffer.from(`${length} ${body}`)
+}
+
+it.each(['package/./package.json', 'other/package.json', 'other\\package.json', 'package/sub/../package.json'])(
+  'refuses the manifest overwrite spelling %s before package execution',
+  async name => {
+    const { dir, archive, installed } = fixture()
+    writeFileSync(archive, tarball({ name: 'ordinary' }, [tarMember(name, JSON.stringify({ name: BUILDR }))]))
+    const outcome = await checkBuildrInstall(installed, [archive], dir)
+    expect(outcome?.code).toBe('package-identity-unverified')
+    expect(outcome?.requested).toEqual([])
+    expect(outcome?.unverified[0]?.reason).toContain('duplicate')
+  },
+)
+
+it('reads the actual stripped manifest identity even when its first directory is not package', async () => {
+  const { dir, archive, installed } = fixture()
+  writeFileSync(archive, gzipSync(Buffer.concat([tarMember('other/package.json', JSON.stringify({ name: BUILDR })), Buffer.alloc(1024)])))
+  expect(await checkBuildrInstall(installed, [archive], dir)).toMatchObject({ code: 'buildr-conflict', requested: [BUILDR] })
+})
+
+it.each([
+  { type: 'x', metadata: paxRecord('package/') },
+  { type: 'x', metadata: paxRecord('') },
+  { type: 'L', metadata: Buffer.from('package/\0') },
+  { type: 'L', metadata: Buffer.from('\0') },
+])('refuses empty stripped $type path metadata instead of overlooking the following header', async ({ type, metadata }) => {
+  const { dir, archive, installed } = fixture()
+  writeFileSync(archive, tarball({ name: 'ordinary' }, [
+    tarMember('package/metadata', metadata, type),
+    tarMember('package/package.json', JSON.stringify({ name: BUILDR })),
+  ]))
+  const outcome = await checkBuildrInstall(installed, [archive], dir)
