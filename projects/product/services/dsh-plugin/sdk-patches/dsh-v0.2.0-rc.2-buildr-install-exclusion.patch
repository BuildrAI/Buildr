diff --git a/packages/boot/plugin-manager/src/buildr-install.ts b/packages/boot/plugin-manager/src/buildr-install.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0ebe2078049f7ef66e4a89df8dbf215d7800bb39
--- /dev/null
+++ b/packages/boot/plugin-manager/src/buildr-install.ts
@@ -0,0 +1,323 @@
+/** Exact Buildr package identity checks shared by inspection and locked installation. */
+import { open } from 'node:fs/promises'
+import { join, posix } from 'node:path'
+import { createGunzip } from 'node:zlib'
+import type { ProfileManifest } from '@deepseek-ai/dsh-app-boot'
+import { parseInstallSpec, type ParsedInstallSpec } from './install-spec.ts'
+import type { BuildrInstallRejection } from './types.ts'
+
+/** Installed packages count even when their bundle is not enabled. */
+const BUILDR_PACKAGES = new Set([
+  '@buildr-ai/buildr-dsh-plugin',
+  '@buildr-ai/buildr-dsh-plugin-dev',
+  '@buildr-ai/buildr-dsh-development-composition',
+  '@buildr-ai/dsh-plugin-dev',
+])
+/** Limits apply to the entire archive, including skipped members. */
+const MAX_MANIFEST_BYTES = 256 * 1024
+const MAX_ARCHIVE_BYTES = 64 * 1024 * 1024
+const MAX_EXPANDED_BYTES = 256 * 1024 * 1024
+const MAX_ARCHIVE_ENTRIES = 50_000
+
+type InstallIdentity =
+  | { readonly name: string; readonly manifest?: object; readonly spec: string }
+  | { readonly spec: string; readonly reason: string; readonly local: boolean }
+
+/** pnpm's direct fields, without following any package's dependency closure.
+ * @param manifest The current profile manifest.
+ * @returns All direct declarations, including disabled bundles.
+ */
+export function directDependencies(manifest: ProfileManifest): Record<string, string> {
+  const extra = manifest as ProfileManifest & { devDependencies?: Record<string, string>; optionalDependencies?: Record<string, string> }
+  return { ...extra.devDependencies, ...manifest.dependencies, ...extra.optionalDependencies }
+}
+
+/** Explicit npm aliases name the target; other named protocols need their own readable manifest. */
+function registryIdentity(parsed: Extract<ParsedInstallSpec, { kind: 'registry' }>): string | undefined {
+  if (parsed.range?.startsWith('npm:')) {
+    const target = parseInstallSpec(parsed.range.slice(4))
+    return target.kind === 'registry' && !target.range?.includes(':') ? target.name : undefined
+  }
+  return parsed.range?.includes(':') ? undefined : parsed.name
+}
+
+/** Only exact family identities, including an explicitly declared npm alias. */
+async function installedBuildrPackages(manifest: ProfileManifest, dir: string): Promise<{
+  installed: string[]; unverified: BuildrInstallRejection['unverified']
+}> {
+  const installed: string[] = []
+  const unverified: BuildrInstallRejection['unverified'] = []
+  for (const [name, range] of Object.entries(directDependencies(manifest))) {
+    if (BUILDR_PACKAGES.has(name)) { installed.push(name); continue }
+    try {
+      const declared = parseInstallSpec(name)
+      if (declared.kind !== 'registry' || declared.range !== undefined || typeof range !== 'string') throw new Error('invalid direct package declaration')
+      if (range.startsWith('npm:')) {
+        const alias = parseInstallSpec(`${name}@${range}`)
+        const target = alias.kind === 'registry' ? registryIdentity(alias) : undefined
+        if (target === undefined) throw new Error('unverified npm alias target')
+        if (BUILDR_PACKAGES.has(target)) installed.push(`${name} (${target})`)
+        continue
+      }
+      const identity = manifestIdentity(await readManifest(join(dir, 'node_modules', name, 'package.json')))
+      if (BUILDR_PACKAGES.has(identity.name)) installed.push(`${name} (${identity.name})`)
+    } catch (error) {
+      // A missing plain registry dependency has no alternate manifest identity.
+      // Missing or invalid local/aliased packages must not be treated as unrelated.
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT' && typeof range === 'string'
+        && !range.includes(':') && !range.includes('/') && !range.startsWith('.')) continue
+      unverified.push({ spec: name, reason: error instanceof Error ? error.message : String(error) })
+    }
+  }
+  return { installed: installed.sort(), unverified }
+}
+
+/** Validate the file boundary before using a manifest as an identity. */
+function manifestIdentity(text: Buffer): { name: string; manifest: object } {
+  if (text.length > MAX_MANIFEST_BYTES) throw new Error('package.json exceeds the 256 KiB identity limit')
+  const value: unknown = JSON.parse(text.toString('utf8'))
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) throw new Error('package.json is not an object')
+  const name = (value as Record<string, unknown>).name
+  if (typeof name !== 'string') throw new Error('package.json names no package')
+  const parsed = parseInstallSpec(name)
+  if (parsed.kind !== 'registry' || parsed.range !== undefined || parsed.name !== name) throw new Error('package.json has no valid package name')
+  return { name, manifest: value }
+}
+
+/** Read one regular file through its opened descriptor, never load its code. */
+async function readManifest(path: string): Promise<Buffer> {
+  const file = await open(path, 'r')
+  try {
+    const stat = await file.stat()
+    if (!stat.isFile() || stat.size > MAX_MANIFEST_BYTES) throw new Error('package.json is not a bounded regular file')
+    const bytes = Buffer.alloc(MAX_MANIFEST_BYTES + 1)
+    let length = 0
+    while (length < bytes.length) {
+      const read = await file.read(bytes, length, bytes.length - length, length)
+      if (read.bytesRead === 0) break
+      length += read.bytesRead
+    }
+    if (length > MAX_MANIFEST_BYTES) throw new Error('package.json exceeds the 256 KiB identity limit')
+    const after = await file.stat()
+    if (length !== stat.size || after.size !== stat.size || after.mtimeMs !== stat.mtimeMs || after.ctimeMs !== stat.ctimeMs) {
+      throw new Error('package.json changed while its identity was being read')
+    }
+    return bytes.subarray(0, length)
+  } finally { await file.close() }
+}
+
+function tarText(bytes: Buffer): string { return bytes.toString('utf8').replace(/\0.*$/s, '') }
+function tarNumber(bytes: Buffer): number {
+  const text = tarText(bytes).trim()
+  if (!/^[0-7]+$/.test(text)) throw new Error('unsupported tar size or checksum')
+  const number = Number.parseInt(text, 8)
+  if (!Number.isSafeInteger(number)) throw new Error('tar member size is not bounded')
+  return number
+}
+
+/** Match pnpm 11.7's stripped member key, then reject ambiguous filesystem aliases. */
+function archivePackageManifest(name: string, extended: boolean): boolean {
+  // Ordinary USTAR names strip the first slash or backslash. PAX/GNU paths
+  // strip only their first slash, as pnpm's tarball worker does.
+  const separator = extended ? name.indexOf('/') : name.search(/[\/\\]/)
+  let relative = separator < 0 ? name : name.slice(separator + 1)
+  if (relative.includes('./') || relative.includes('.\\')) {
+    relative = posix.join('/', relative.replaceAll('\\', '/')).slice(1)
+  }
+  relative = relative.replaceAll('//', '/')
+  if (relative === 'package.json') return true
+  // A different Map key can still denote the same written file after path
+  // joining/normalization. Do not use an ambiguous member as an identity.
+  if (posix.join('/', relative.replaceAll('\\', '/')).slice(1) === 'package.json') {
+    throw new Error('ambiguous extracted package.json path')
+  }
+  return false
+}
+
+/** PAX path metadata is scoped to the following member; size overrides are not accepted. */
+function paxPath(bytes: Buffer): string | undefined {
+  let offset = 0
+  let path: string | undefined
+  while (offset < bytes.length) {
+    const space = bytes.indexOf(32, offset)
+    if (space < 0) throw new Error('invalid tar path metadata')
+    const digits = bytes.subarray(offset, space).toString('ascii')
+    const length = /^\d+$/.test(digits) ? Number(digits) : 0
+    if (!Number.isSafeInteger(length) || length <= space - offset + 1 || offset + length > bytes.length) throw new Error('invalid tar path metadata')
+    const entry = bytes.subarray(space + 1, offset + length)
+    if (entry.at(-1) !== 10) throw new Error('invalid tar path metadata')
+    const record = entry.subarray(0, -1).toString('utf8')
+    if (record.startsWith('path=')) {
+      if (path !== undefined) throw new Error('duplicate tar path metadata')
+      path = record.slice(5)
+    }
+    if (record.startsWith('size=')) throw new Error('unsupported tar size override')
+    offset += length
+  }
+  return path
+}
+
+/** Stream a gzip tar and retain its single extracted root package.json, without extraction. */
+async function archiveManifest(path: string): Promise<Buffer> {
+  const file = await open(path, 'r')
+  let input: ReturnType<typeof file.createReadStream> | undefined
+  const decoder = createGunzip()
+  try {
+    const stat = await file.stat()
+    if (!stat.isFile() || stat.size > MAX_ARCHIVE_BYTES) throw new Error('archive exceeds the 64 MiB identity limit or is not a regular file')
+    input = file.createReadStream({ autoClose: false, end: MAX_ARCHIVE_BYTES })
+    input.on('error', error => decoder.destroy(error))
+    input.pipe(decoder)
+    let pending = Buffer.alloc(0)
+    let expanded = 0
+    let entries = 0
+    let remaining = 0
+    let padding = 0
+    let zeroBlocks = 0
+    let nextPath: string | undefined
+    let capture: 'manifest' | 'pax' | 'long-path' | undefined
+    let parts: Buffer[] = []
+    let found: Buffer | undefined
+    for await (const chunk of decoder) {
+      const bytes = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk as string)
+      expanded += bytes.length
+      if (expanded > MAX_EXPANDED_BYTES) throw new Error('archive exceeds the 256 MiB expanded identity limit')
