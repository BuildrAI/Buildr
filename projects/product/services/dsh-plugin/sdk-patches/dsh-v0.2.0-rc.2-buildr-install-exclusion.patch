--- /dev/null
+++ b/packages/boot/plugin-manager/tests/tar-fixture.ts
@@ -0,0 +1,25 @@
+/** Standard npm tar members, created entirely in a temporary test fixture. */
+import { gzipSync } from 'node:zlib'
+
+export function tarMember(name: string, content: Buffer | string, type = '0'): Buffer {
+  const bytes = Buffer.isBuffer(content) ? content : Buffer.from(content)
+  const header = Buffer.alloc(512)
+  header.write(name, 0, 100, 'utf8')
+  header.write('0000644\0', 100)
+  header.write('0000000\0', 108)
+  header.write('0000000\0', 116)
+  header.write(bytes.length.toString(8).padStart(11, '0') + '\0', 124)
+  header.write('00000000000\0', 136)
+  header.fill(32, 148, 156)
+  header.write(type, 156, 1)
+  header.write('ustar\0', 257)
+  header.write('00', 263)
+  const checksum = header.reduce((sum, byte) => sum + byte, 0)
+  header.write(checksum.toString(8).padStart(6, '0') + '\0 ', 148)
+  return Buffer.concat([header, bytes, Buffer.alloc((512 - bytes.length % 512) % 512)])
+}
+
+export function tarball(manifest: object, extra: Buffer[] = []): Buffer {
+  return gzipSync(Buffer.concat([tarMember('package/package.json', JSON.stringify(manifest)), ...extra, Buffer.alloc(1024)]))
+}
