+  expect(outcome?.unverified[0]?.reason).toContain('empty stripped')
+})
+
+it('reads a PAX-scoped package manifest and rejects a duplicate through an alternate tar path', async () => {
+  const { dir, archive, installed } = fixture()
+  const members = [tarMember('package/metadata', paxRecord('package/package.json'), 'x'),
+    tarMember('package/renamed', JSON.stringify({ name: BUILDR }))]
+  writeFileSync(archive, gzipSync(Buffer.concat([...members, Buffer.alloc(1024)])))
+  expect(await checkBuildrInstall(installed, [archive], dir)).toMatchObject({ code: 'buildr-conflict', requested: [BUILDR] })
+  writeFileSync(archive, tarball({ name: 'ordinary' }, members))
+  const outcome = await checkBuildrInstall(installed, [archive], dir)
+  expect(outcome?.code).toBe('package-identity-unverified')
+  expect(outcome?.unverified[0]?.reason).toContain('duplicate')
+})
+
+it.each(['invalid checksum', 'truncated archive', 'missing manifest', 'global path metadata'])('refuses %s without extracting an archive', async form => {
+  const { dir, archive, installed } = fixture()
+  const header = tarMember('package/package.json', JSON.stringify({ name: 'ordinary' }))
+  const bytes = form === 'invalid checksum' ? Buffer.from(header) : header
+  if (form === 'invalid checksum') bytes[0] = 255
+  writeFileSync(archive, gzipSync(form === 'missing manifest' ? Buffer.alloc(1024)
+    : form === 'global path metadata' ? Buffer.concat([tarMember('package/metadata', paxRecord('package/package.json'), 'g'), header, Buffer.alloc(1024)])
+      : form === 'truncated archive' ? header : Buffer.concat([bytes, Buffer.alloc(1024)])))
+  expect(await checkBuildrInstall(installed, [archive], dir)).toMatchObject({ code: 'package-identity-unverified' })
+})
+
+it('accepts the exact manifest byte limit and rejects the next byte', async () => {
+  const { dir, archive } = fixture()
+  const manifest = { name: 'ordinary', padding: '' }
+  manifest.padding = 'x'.repeat(256 * 1024 - Buffer.byteLength(JSON.stringify(manifest)))
+  writeFileSync(archive, tarball(manifest))
+  expect(await checkBuildrInstall({}, [archive], dir)).toBeUndefined()
+  manifest.padding += 'x'
+  writeFileSync(archive, tarball(manifest))
+  expect(await checkBuildrInstall({}, [archive], dir)).toMatchObject({ code: 'package-identity-unverified' })
+})
+
+it('bounds compressed input using the opened regular file before starting decompression', async () => {
+  const { dir, archive } = fixture()
+  writeFileSync(archive, '')
+  truncateSync(archive, 64 * 1024 * 1024 + 1)
+  const outcome = await checkBuildrInstall({}, [archive], dir)
+  expect(outcome?.code).toBe('package-identity-unverified')
+  expect(outcome?.unverified[0]?.reason).toContain('64 MiB')
+})
+
+it('bounds all expanded bytes, including a skipped member after the package manifest', async () => {
+  const { dir, archive } = fixture()
+  const header = tarMember('package/large', '')
+  header.write((256 * 1024 * 1024).toString(8).padStart(11, '0') + '\0', 124)
+  header.fill(32, 148, 156)
+  header.write(header.reduce((sum, byte) => sum + byte, 0).toString(8).padStart(6, '0') + '\0 ', 148)
+  const chunk = Buffer.alloc(64 * 1024)
+  function* contents() {
+    yield tarMember('package/package.json', '{"name":"ordinary"}')
+    yield header
+    for (let index = 0; index < 4096; index += 1) yield chunk
+    yield Buffer.alloc(1024)
+  }
+  await pipeline(Readable.from(contents()), createGzip(), createWriteStream(archive))
+  const outcome = await checkBuildrInstall({}, [archive], dir)
+  expect(outcome?.code).toBe('package-identity-unverified')
+  expect(outcome?.unverified[0]?.reason).toContain('256 MiB expanded')
+}, 20_000)
+
+it('bounds member count even when every skipped member is empty', async () => {
+  const { dir, archive } = fixture()
+  const empty = tarMember('package/empty', '')
+  writeFileSync(archive, tarball({ name: 'ordinary' }, Array.from({ length: 50_000 }, () => empty)))
+  const outcome = await checkBuildrInstall({}, [archive], dir)
+  expect(outcome?.code).toBe('package-identity-unverified')
+  expect(outcome?.unverified[0]?.reason).toContain('too many')
+})
