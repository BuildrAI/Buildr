  "cards": [
    {
      "dot": "emerald",
      "title": "准备与公开是两个边界",
      "items": [
        "prepare 止于逐包就绪，不能自动越过人的公开授权",
        "主包与插件独立版本、独立原包，公开顺序由兼容结果确定"
      ]
    },
    {
      "dot": "cyan",
      "title": "两包独立产包，纳入后采用原候选",
      "items": [
        "候选阶段按需要分别形成原包及必要平台、组合证明",
        "main 纳入后采用已验证插件原包，不在该准备步骤重新产包"
      ]
    },
    {
      "dot": "rose",
      "title": "失败从所属步骤接续",
      "items": [
        "检查补检查、汇总重汇总、登记重登记；有效结果和原包保留",
        "请求未知先回读；自举结果独立报告，当前默认回传尚未接通"
